{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": [
    "src",
    // A5-PR1: the tool-dispatch lane (closed-world Guard + Scoped Dispatcher).
    // Same rationale as `domain`'s `tool-governance/src` entry: the live glue
    // that consumes it is plain .mjs, so without this entry the lane would be
    // typechecked by nothing at all.
    "tool-dispatch",
    // A5-PR2: the tool-admission lane (Operation Admission + one-shot grant).
    // Same rationale as PR1's entry: typecheck coverage for the lane.
    "tool-admission",
    // U6 PR1: the governance-center lane (closed contribution schema +
    // read-only registry + §5 kernel + public-seam host adapter). Consumed
    // by plain .mjs shadow glue only, so without this entry the lane would
    // be typechecked by nothing at all (same rationale as the two above).
    "governance-center",
    // A5 integration wiring (G-d, Scope-2): PR3 ControlledFs and PR4
    // sandbox-provider join the SHARED typecheck surface (their reviews'
    // "lane never entered a repo-wide tsc" condition). `controlled-fs` is
    // listed whole (src + lane tests typecheck); the build tsconfig narrows
    // the emit to `controlled-fs/src` so lane tests never reach dist.
    "controlled-fs",
    // Provider side: COMPILE FACE ONLY — factory export stays an explicit
    // call, no live-registry import, no production consumer (a5w suite
    // re-pins the dormancy leg; a5p4 hygiene keeps its own self-check).
    "sandbox-provider",
    // Alpha.6 PR0 (Lane 2): the review-delegation vocabulary lane. Dormant by
    // declaration (nothing imports it until the named Center-Interface PR), so
    // it must be NAMED here or no repo-wide tsc ever reads it.
    "review-mandate",
    "review-wake",
    // Alpha.6 PR2' (Lane 2): the review router + non-authorizing assignment facts. Dormant by
    // declaration, and consumed by no production file, so this entry is the only thing that puts the
    // lane in front of a compiler at all — measured, not assumed: with the entry missing,
    // `tsc --listFilesOnly` listed every file of the two lanes above and none of this one.
    "review-assignment",
    // Alpha.6 PR4' (Lane 2): the review-wake defer lane — a pre-kernel gate on the Leader notification port
    // plus the process-local floor it reads. Consumed by no production file and gated by no flag of any kind;
    // both halves are measured by `a6-pr4-lane-hygiene.test.ts` — a walk for a module import of the lane, and a
    // screen of every production file for ANY spelling of the name: kebab (`review-defer`), screaming
    // (`REVIEW_DEFER`) or camel (`reviewDefer`), so an option like `reviewDeferEnabled` cannot appear in the
    // product without failing a leg. Round 3 caught the first version of this sentence crediting a screen that
    // read only two of those three spellings. (The round-2 review caught this comment
    // advertising a `config.teamToolPlane.reviewDeferEnabled` switch that exists nowhere in the tree — a comment
    // naming a control that does not exist is the same species of defect as a tool that controls nothing.)
    // Named here for the same measured reason as the two lanes above: without the entry no repo-wide tsc reads
    // the directory at all.
    "review-defer",
    "test",
    "vitest.config.ts"
  ]
}
