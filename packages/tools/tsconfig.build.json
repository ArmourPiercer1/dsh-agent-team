{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": [
    "src",
    // GLUE-2 (gap C-11, coordinator queue): the a5p5 Search/Shell lane joins
    // the PRODUCTION COMPILE FACE. Emit only — this line creates no import
    // edge and no barrel entry (the shared `src/index.ts` still does not
    // know the lane; the dormant-audit pins that leg unchanged, and its
    // walk skips `dist`, so the emitted declarations never count as naming).
    // The lane src is import-self-contained (only `.` and `node:` — verified
    // this round). The kit switches from its lane-local ESM build to this
    // dist as the lane's own follow-up (queue note).
    "a5p5-tools/src"
  ],
  // A5 READ PILOT (a5-read-pilot branch): the bounded read fork is an ISOLATED
  // pilot — it is deliberately NOT on the production compile face (zero
  // production assembly change, root release-order constraint ①). The lane
  // typechecks on the dev config (`tsc -p tsconfig.json`, src+test, noEmit,
  // where node builtins resolve) and runs under vitest; mounting happens only
  // in pilot worlds (profile rows / kit harnesses), never here.
  "exclude": [
    "src/governed-fs"
  ]
}
