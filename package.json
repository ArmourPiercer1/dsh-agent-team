{
  "name": "dsh-agent-team",
  "version": "0.0.0",
  "private": true,
  "description": "DSH Agent Team vNext plugin set — public-seam only, CORE PATCH BUDGET = 0.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./packages/client/composition-shim/index.js",
    "./host": "./packages/runtime/dist/packages/runtime/src/plugin/host.js",
    "./client": "./packages/client/composition-shim/client-bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "packages/client/composition-shim",
    "packages/runtime/dist",
    "packages/runtime/root-binding"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "build:composition": "node scripts/place-dist-glue.mjs && node scripts/build-client-composition.mjs packages/client packages/client/composition-shim",
    "prepare": "pnpm install --ignore-scripts && pnpm build && pnpm build:composition",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:node": "node scripts/run-tests.mjs",
    "smoke:composition": "node scripts/composition-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
