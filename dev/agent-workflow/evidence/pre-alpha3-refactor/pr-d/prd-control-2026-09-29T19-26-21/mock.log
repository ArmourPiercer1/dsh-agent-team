                        "requestToken",
                        "requestTokens"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "name": "team_create_member",
                    "description": "Create a NEW member instance from a blueprint template (explicit creation; the activation authority enforces quota, envelope, and gates).",
