>   // correctly instead of crashing. Nothing else in the kit differs from the tracked byte.
>   // (Long-term fix for the TRACKED kits = the focused test-infra PR; this scratch copy is
>   // the disclosed stopgap that lets the legs run unchanged.)
>   let r
>   try { r = await fetch(url, { signal: AbortSignal.timeout(10_000) }) } catch (e) { return { status: 0, error: String(e?.message ?? e) } }
