script-source,141,node:internal/crypto/pbkdf2,'use strict';\n\nconst {\n  ArrayBuffer\x2C\n  FunctionPrototypeCall\x2C\n  PromiseResolve\x2C\n} = primordials;\n\nconst { Buffer } = require('buffer');\n\nconst {\n  PBKDF2Job\x2C\n  kCryptoJobAsync\x2C\n  kCryptoJobSync\x2C\n  kCryptoJobWebCrypto\x2C\n} = internalBinding('crypto');\n\nconst {\n  validateFunction\x2C\n  validateInt32\x2C\n  validateString\x2C\n} = require('internal/validators');\n\nconst {\n  getArrayBufferOrView\x2C\n  normalizeHashName\x2C\n  jobPromise\x2C\n} = require('internal/crypto/util');\n\nconst {\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst {\n  getCryptoKeyHandle\x2C\n} = require('internal/crypto/keys');\n\nfunction pbkdf2(password\x2C salt\x2C iterations\x2C keylen\x2C digest\x2C callback) {\n  if (typeof digest === 'function') {\n    callback = digest;\n    digest = undefined;\n  }\n\n  ({ password\x2C salt\x2C iterations\x2C keylen\x2C digest } =\n    check(password\x2C salt\x2C iterations\x2C keylen\x2C digest));\n\n  validateFunction(callback\x2C 'callback');\n\n  const job = new PBKDF2Job(\n    kCryptoJobAsync\x2C\n    password\x2C\n    salt\x2C\n    iterations\x2C\n    keylen\x2C\n    digest);\n\n  job.ondone = (err\x2C result) => {\n    if (err !== undefined)\n      return FunctionPrototypeCall(callback\x2C job\x2C err);\n    const buf = Buffer.from(result);\n    return FunctionPrototypeCall(callback\x2C job\x2C null\x2C buf);\n  };\n\n  job.run();\n}\n\nfunction pbkdf2Sync(password\x2C salt\x2C iterations\x2C keylen\x2C digest) {\n  ({ password\x2C salt\x2C iterations\x2C keylen\x2C digest } =\n    check(password\x2C salt\x2C iterations\x2C keylen\x2C digest));\n\n  const job = new PBKDF2Job(\n    kCryptoJobSync\x2C\n    password\x2C\n    salt\x2C\n    iterations\x2C\n    keylen\x2C\n    digest);\n\n  const { 0: err\x2C 1: result } = job.run();\n  if (err !== undefined)\n    throw err;\n\n  return Buffer.from(result);\n}\n\nfunction check(password\x2C salt\x2C iterations\x2C keylen\x2C digest) {\n  validateString(digest\x2C 'digest');\n\n  password = getArrayBufferOrView(password\x2C 'password');\n  salt = getArrayBufferOrView(salt\x2C 'salt');\n  // OpenSSL uses a signed int to represent these values\x2C so we are restricted\n  // to the 31-bit range here (which is plenty).\n  validateInt32(iterations\x2C 'iterations'\x2C 1);\n  validateInt32(keylen\x2C 'keylen'\x2C 0);\n  // Coerce -0 to +0.\n  keylen += 0;\n\n  return { password\x2C salt\x2C iterations\x2C keylen\x2C digest };\n}\n\nfunction validatePbkdf2DeriveBitsLength(length) {\n  if (length === null)\n    throw lazyDOMException('length cannot be null'\x2C 'OperationError');\n\n  if (length % 8) {\n    throw lazyDOMException(\n      'length must be a multiple of 8'\x2C\n      'OperationError');\n  }\n}\n\nfunction pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length) {\n  validatePbkdf2DeriveBitsLength(length);\n  const { iterations\x2C hash\x2C salt } = algorithm;\n\n  if (length === 0)\n    return PromiseResolve(new ArrayBuffer(0));\n\n  return jobPromise(() => new PBKDF2Job(\n    kCryptoJobWebCrypto\x2C\n    getCryptoKeyHandle(baseKey)\x2C\n    salt\x2C\n    iterations\x2C\n    length / 8\x2C\n    normalizeHashName(hash.name)));\n}\n\nmodule.exports = {\n  pbkdf2\x2C\n  pbkdf2Sync\x2C\n  pbkdf2DeriveBits\x2C\n  validatePbkdf2DeriveBitsLength\x2C\n};\n
