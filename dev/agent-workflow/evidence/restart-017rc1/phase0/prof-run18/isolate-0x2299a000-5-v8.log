script-source,193,node:internal/crypto/webcrypto,'use strict';\n\nconst {\n  ArrayIsArray\x2C\n  ArrayPrototypeSlice\x2C\n  FunctionPrototypeCall\x2C\n  JSONParse\x2C\n  JSONStringify\x2C\n  ObjectDefineProperties\x2C\n  ObjectKeys\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  PromiseReject\x2C\n  PromiseResolve\x2C\n  ReflectApply\x2C\n  ReflectConstruct\x2C\n  SafeArrayIterator\x2C\n  StringPrototypeRepeat\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeStartsWith\x2C\n  SymbolIterator\x2C\n  SymbolToStringTag\x2C\n  TypedArrayPrototypeGetBuffer\x2C\n} = primordials;\n\nconst {\n  CShakeJob\x2C\n  kWebCryptoKeyFormatRaw\x2C\n  kWebCryptoKeyFormatPKCS8\x2C\n  kWebCryptoKeyFormatSPKI\x2C\n  kWebCryptoCipherEncrypt\x2C\n  kWebCryptoCipherDecrypt\x2C\n} = internalBinding('crypto');\n\nconst {\n  decodeUTF8\x2C\n  encodeUtf8String\x2C\n} = internalBinding('encoding_binding');\n\nconst {\n  codes: {\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  CryptoKey\x2C\n  getCryptoKeyAlgorithm\x2C\n  getCryptoKeyExtractable\x2C\n  getCryptoKeyHandle\x2C\n  getCryptoKeyType\x2C\n  getCryptoKeyUsages\x2C\n  getCryptoKeyUsagesMask\x2C\n  hasCryptoKeyUsage\x2C\n  importGenericSecretKey\x2C\n  toPublicCryptoKey\x2C\n} = require('internal/crypto/keys');\n\nconst {\n  asyncDigest\x2C\n} = require('internal/crypto/hash');\n\nconst {\n  cleanupWebCryptoResult\x2C\n  getBlockSize\x2C\n  jobPromiseThen\x2C\n  normalizeAlgorithm\x2C\n  normalizeHashName\x2C\n  numBitsToBytes\x2C\n  prepareWebCryptoResult\x2C\n  validateMaxBufferLength\x2C\n  getOptionalByteLength\x2C\n} = require('internal/crypto/util');\n\nconst {\n  emitExperimentalWarning\x2C\n  kEnumerableProperty\x2C\n  lazyDOMException\x2C\n  setOwnProperty\x2C\n} = require('internal/util');\n\nconst {\n  getRandomValues: _getRandomValues\x2C\n  randomUUID: _randomUUID\x2C\n} = require('internal/crypto/random');\n\nconst {\n  isPromise\x2C\n} = require('internal/util/types');\n\nlet webidl;\n\n// WebCrypto methods return promises\x2C including for synchronous validation\n// failures. Keep that conversion in one place so method bodies stay readable.\nfunction callSubtleCryptoMethod(fn\x2C receiver\x2C args) {\n  try {\n    const result = ReflectApply(fn\x2C receiver\x2C args);\n    if (isPromise(result))\n      return result;\n    // PromiseResolve() performs thenable assimilation for object results.\n    // Shadow inherited then accessors while it resolves synchronous results.\n    const shouldCleanupResult = prepareWebCryptoResult(result);\n    try {\n      return PromiseResolve(result);\n    } finally {\n      if (shouldCleanupResult)\n        cleanupWebCryptoResult(result);\n    }\n  } catch (err) {\n    return PromiseReject(err);\n  }\n}\n\nconst kArgumentContexts = [\n  '1st argument'\x2C\n  '2nd argument'\x2C\n  '3rd argument'\x2C\n  '4th argument'\x2C\n  '5th argument'\x2C\n  '6th argument'\x2C\n  '7th argument'\x2C\n];\n\nfunction prepareSubtleMethod(receiver\x2C method\x2C argLength\x2C required) {\n  if (receiver !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = `Failed to execute '${method}' on 'SubtleCrypto'`;\n  webidl.requiredArguments(argLength\x2C required\x2C { prefix });\n  return prefix;\n}\n\nfunction convertSubtleArgument(prefix\x2C converter\x2C value\x2C index) {\n  // Mirrors makeOptions() in internal/webidl\x2C including why it stays an\n  // ordinary literal: the converters read every member below\x2C and an absent\n  // one would resolve through %Object.prototype%.\n  return webidl.converters[converter](value\x2C {\n    prefix\x2C\n    context: kArgumentContexts[index]\x2C\n    code: undefined\x2C\n    enforceRange: undefined\x2C\n    clamp: undefined\x2C\n    allowShared: undefined\x2C\n    allowResizable: undefined\x2C\n  });\n}\n\nfunction digest(algorithm\x2C data) {\n  return callSubtleCryptoMethod(digestImpl\x2C this\x2C arguments);\n}\n\nfunction digestImpl(algorithm\x2C data) {\n  const prefix = prepareSubtleMethod(this\x2C 'digest'\x2C arguments.length\x2C 2);\n  let i = 0;\n  algorithm = convertSubtleArgument(\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\n  data = convertSubtleArgument(prefix\x2C 'BufferSource'\x2C data\x2C i++);\n\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'digest');\n\n  return FunctionPrototypeCall(asyncDigest\x2C this\x2C normalizedAlgorithm\x2C data);\n}\n\nfunction randomUUID() {\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n  return _randomUUID();\n}\n\nfunction generateKey(\n  algorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  return callSubtleCryptoMethod(generateKeyImpl\x2C this\x2C arguments);\n}\n\nfunction generateKeyImpl(\n  algorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  const prefix = prepareSubtleMethod(this\x2C 'generateKey'\x2C arguments.length\x2C 3);\n  let i = 0;\n  algorithm = convertSubtleArgument(\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\n  extractable = convertSubtleArgument(prefix\x2C 'boolean'\x2C extractable\x2C i++);\n  const usages = convertSubtleArgument(\n    prefix\x2C 'sequence<KeyUsage>'\x2C keyUsages\x2C i++);\n\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'generateKey');\n  switch (normalizedAlgorithm.name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      return require('internal/crypto/rsa')\n        .rsaKeyGenerate(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return require('internal/crypto/cfrg')\n        .cfrgGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return require('internal/crypto/ec')\n        .ecGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'HMAC':\n      return require('internal/crypto/mac')\n        .hmacGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-OCB':\n      // Fall through\n    case 'AES-KW':\n      return require('internal/crypto/aes')\n        .aesGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'ChaCha20-Poly1305':\n      return require('internal/crypto/chacha20_poly1305')\n        .c20pGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      return require('internal/crypto/ml_dsa')\n        .mlDsaGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      return require('internal/crypto/ml_kem')\n        .mlKemGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    case 'KMAC128':\n      // Fall through\n    case 'KMAC256':\n      return require('internal/crypto/mac')\n        .kmacGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\n    /* c8 ignore start */\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n    /* c8 ignore stop */\n  }\n}\n\nfunction deriveBits(algorithm\x2C baseKey\x2C length = null) {\n  return callSubtleCryptoMethod(deriveBitsImpl\x2C this\x2C arguments);\n}\n\nfunction deriveBitsImpl(algorithm\x2C baseKey\x2C length = null) {\n  const prefix = prepareSubtleMethod(this\x2C 'deriveBits'\x2C arguments.length\x2C 2);\n  let i = 0;\n  algorithm = convertSubtleArgument(\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\n  baseKey = convertSubtleArgument(prefix\x2C 'CryptoKey'\x2C baseKey\x2C i++);\n  if (length !== null) {\n    length = webidl.converters['unsigned long'](length\x2C {\n      prefix\x2C\n      context: kArgumentContexts[i++]\x2C\n      enforceRange: true\x2C\n    });\n  }\n\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveBits')) {\n    throw lazyDOMException(\n      'baseKey does not have deriveBits usage'\x2C\n      'InvalidAccessError');\n  }\n  if (getCryptoKeyAlgorithm(baseKey).name !== normalizedAlgorithm.name)\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\n  switch (normalizedAlgorithm.name) {\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ECDH':\n      return require('internal/crypto/diffiehellman')\n        .ecdhDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n    case 'HKDF':\n      return require('internal/crypto/hkdf')\n        .hkdfDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n    case 'PBKDF2':\n      return require('internal/crypto/pbkdf2')\n        .pbkdf2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n    case 'Argon2d':\n      // Fall through\n    case 'Argon2i':\n      // Fall through\n    case 'Argon2id':\n      return require('internal/crypto/argon2')\n        .argon2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n    /* c8 ignore start */\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n    /* c8 ignore stop */\n  }\n}\n\nfunction getKeyLength({ name\x2C length\x2C hash }) {\n  switch (name) {\n    case 'AES-CTR':\n    case 'AES-CBC':\n    case 'AES-GCM':\n    case 'AES-OCB':\n    case 'AES-KW':\n      if (length !== 128 && length !== 192 && length !== 256)\n        throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n\n      return length;\n    case 'HMAC':\n      if (length === undefined) {\n        return getBlockSize(hash?.name);\n      }\n\n      if (typeof length === 'number' && length !== 0) {\n        return length;\n      }\n\n      throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n    case 'KMAC128':\n    case 'KMAC256':\n      if (typeof length === 'number') {\n        return length;\n      }\n\n      return name === 'KMAC128' ? 128 : 256;\n    case 'HKDF':\n    case 'PBKDF2':\n    case 'Argon2d':\n    case 'Argon2i':\n    case 'Argon2id':\n      return null;\n    case 'ChaCha20-Poly1305':\n      return 256;\n  }\n}\n\nfunction deriveKey(\n  algorithm\x2C\n  baseKey\x2C\n  derivedKeyType\x2C\n  extractable\x2C\n  keyUsages) {\n  return callSubtleCryptoMethod(deriveKeyImpl\x2C this\x2C arguments);\n}\n\nfunction deriveKeyImpl(\n  algorithm\x2C\n  baseKey\x2C\n  derivedKeyType\x2C\n  extractable\x2C\n  keyUsages) {\n  const prefix = prepareSubtleMethod(this\x2C 'deriveKey'\x2C arguments.length\x2C 5);\n  let i = 0;\n  algorithm = convertSubtleArgument(\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\n  baseKey = convertSubtleArgument(prefix\x2C 'CryptoKey'\x2C baseKey\x2C i++);\n  derivedKeyType = convertSubtleArgument(\n    prefix\x2C 'AlgorithmIdentifier'\x2C derivedKeyType\x2C i++);\n  extractable = convertSubtleArgument(prefix\x2C 'boolean'\x2C extractable\x2C i++);\n  const usages = convertSubtleArgument(\n    prefix\x2C 'sequence<KeyUsage>'\x2C keyUsages\x2C i++);\n\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\n  const normalizedDerivedKeyAlgorithmImport =\n    normalizeAlgorithm(derivedKeyType\x2C 'importKey');\n  const normalizedDerivedKeyAlgorithmLength =\n    normalizeAlgorithm(derivedKeyType\x2C 'get key length');\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveKey')) {\n    throw lazyDOMException(\n      'baseKey does not have deriveKey usage'\x2C\n      'InvalidAccessError');\n  }\n  if (getCryptoKeyAlgorithm(baseKey).name !== normalizedAlgorithm.name)\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\n\n  const length = getKeyLength(normalizedDerivedKeyAlgorithmLength);\n  let secret;\n  switch (normalizedAlgorithm.name) {\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ECDH':\n      secret = require('internal/crypto/diffiehellman')\n        .ecdhDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n      break;\n    case 'HKDF':\n      secret = require('internal/crypto/hkdf')\n        .hkdfDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n      break;\n    case 'PBKDF2':\n      secret = require('internal/crypto/pbkdf2')\n        .pbkdf2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n      break;\n    case 'Argon2d':\n      // Fall through\n    case 'Argon2i':\n      // Fall through\n    case 'Argon2id':\n      secret = require('internal/crypto/argon2')\n        .argon2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\n      break;\n    /* c8 ignore start */\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n    /* c8 ignore stop */\n  }\n\n  return jobPromiseThen(secret\x2C (secret) => FunctionPrototypeCall(\n    importKeySync\x2C\n    this\x2C\n    'raw-secret'\x2C\n    secret\x2C\n    normalizedDerivedKeyAlgorithmImport\x2C\n    extractable\x2C\n    usages\x2C\n  ));\n}\n\nfunction exportKeySpki(key) {\n  switch (getCryptoKeyAlgorithm(key).name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      return require('internal/crypto/rsa')\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      return require('internal/crypto/ml_dsa')\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      return require('internal/crypto/ml_kem')\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    default:\n      return undefined;\n  }\n}\n\nfunction exportKeyPkcs8(key) {\n  switch (getCryptoKeyAlgorithm(key).name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      return require('internal/crypto/rsa')\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      return require('internal/crypto/ml_dsa')\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      return require('internal/crypto/ml_kem')\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    default:\n      return undefined;\n  }\n}\n\nfunction exportKeyRawPublic(key\x2C format) {\n  switch (getCryptoKeyAlgorithm(key).name) {\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87': {\n      // ML-DSA keys don't recognize "raw"\n      if (format !== 'raw-public') {\n        return undefined;\n      }\n      return require('internal/crypto/ml_dsa')\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    }\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024': {\n      // ML-KEM keys don't recognize "raw"\n      if (format !== 'raw-public') {\n        return undefined;\n      }\n      return require('internal/crypto/ml_kem')\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    }\n    default:\n      return undefined;\n  }\n}\n\nfunction exportKeyRawSeed(key) {\n  switch (getCryptoKeyAlgorithm(key).name) {\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      return require('internal/crypto/ml_dsa')\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      return require('internal/crypto/ml_kem')\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    default:\n      return undefined;\n  }\n}\n\nfunction exportKeyRawSecret(key\x2C format) {\n  switch (getCryptoKeyAlgorithm(key).name) {\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-KW':\n      // Fall through\n    case 'HMAC':\n      return TypedArrayPrototypeGetBuffer(getCryptoKeyHandle(key).export());\n    case 'AES-OCB':\n      // Fall through\n    case 'KMAC128':\n      // Fall through\n    case 'KMAC256':\n      // Fall through\n    case 'ChaCha20-Poly1305':\n      if (format === 'raw-secret') {\n        return TypedArrayPrototypeGetBuffer(getCryptoKeyHandle(key).export());\n      }\n      return undefined;\n    default:\n      return undefined;\n  }\n}\n\nfunction exportKeyJWK(key) {\n  const algorithm = getCryptoKeyAlgorithm(key);\n  let alg;\n  switch (algorithm.name) {\n    case 'RSASSA-PKCS1-v1_5': {\n      alg = normalizeHashName(\n        algorithm.hash.name\x2C\n        normalizeHashName.kContextJwkRsa);\n      break;\n    }\n    case 'RSA-PSS': {\n      alg = normalizeHashName(\n        algorithm.hash.name\x2C\n        normalizeHashName.kContextJwkRsaPss);\n      break;\n    }\n    case 'RSA-OAEP': {\n      alg = normalizeHashName(\n        algorithm.hash.name\x2C\n        normalizeHashName.kContextJwkRsaOaep);\n      break;\n    }\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      // Fall through\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      break;\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      alg = algorithm.name;\n      break;\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-OCB':\n      // Fall through\n    case 'AES-KW':\n      alg = require('internal/crypto/aes')\n        .getAlgorithmName(algorithm.name\x2C algorithm.length);\n      break;\n    case 'ChaCha20-Poly1305':\n      alg = 'C20P';\n      break;\n    case 'HMAC': {\n      alg = normalizeHashName(\n        algorithm.hash.name\x2C\n        normalizeHashName.kContextJwkHmac);\n      break;\n    }\n    case 'KMAC128':\n      alg = 'K128';\n      break;\n    case 'KMAC256': {\n      alg = 'K256';\n      break;\n    }\n    default:\n      return undefined;\n  }\n\n  // Keep `alg` in the object literal so an inherited setter cannot capture\n  // `parameters` before native export populates key material. Delete it for\n  // algorithms without a JWK alg value to keep the expected shape.\n  const parameters = {\n    key_ops: ArrayPrototypeSlice(getCryptoKeyUsages(key)\x2C 0)\x2C\n    ext: getCryptoKeyExtractable(key)\x2C\n    alg\x2C\n  };\n  if (alg === undefined) delete parameters.alg;\n\n  return getCryptoKeyHandle(key).exportJwk(parameters\x2C true);\n}\n\nfunction exportKeySync(format\x2C key) {\n  const algorithm = getCryptoKeyAlgorithm(key);\n  try {\n    normalizeAlgorithm(algorithm\x2C 'exportKey');\n  } catch {\n    throw lazyDOMException(\n      `${algorithm.name} key export is not supported`\x2C 'NotSupportedError');\n  }\n\n  if (!getCryptoKeyExtractable(key))\n    throw lazyDOMException('key is not extractable'\x2C 'InvalidAccessError');\n\n  const type = getCryptoKeyType(key);\n  let result;\n  switch (format) {\n    case 'spki': {\n      if (type === 'public') {\n        result = exportKeySpki(key);\n      }\n      break;\n    }\n    case 'pkcs8': {\n      if (type === 'private') {\n        result = exportKeyPkcs8(key);\n      }\n      break;\n    }\n    case 'jwk': {\n      result = exportKeyJWK(key);\n      break;\n    }\n    case 'raw-secret': {\n      if (type === 'secret') {\n        result = exportKeyRawSecret(key\x2C format);\n      }\n      break;\n    }\n    case 'raw-public': {\n      if (type === 'public') {\n        result = exportKeyRawPublic(key\x2C format);\n      }\n      break;\n    }\n    case 'raw-seed': {\n      if (type === 'private') {\n        result = exportKeyRawSeed(key);\n      }\n      break;\n    }\n    case 'raw': {\n      if (type === 'secret') {\n        result = exportKeyRawSecret(key\x2C format);\n