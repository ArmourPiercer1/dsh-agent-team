G_TYPE('other'\x2C 'RecordableHistogram'\x2C other);\n    this[kHandle]?.subtract(other[kHandle]);\n  }\n\n  /**\n   * @param {RecordableHistogram} other\n   */\n  add(other) {\n    if (this[kRecordable] === undefined)\n      throw new ERR_INVALID_THIS('RecordableHistogram');\n    if (other[kRecordable] === undefined)\n      throw new ERR_INVALID_ARG_TYPE('other'\x2C 'RecordableHistogram'\x2C other);\n    this[kHandle]?.add(other[kHandle]);\n  }\n\n  [kClone]() {\n    const handle = this[kHandle];\n    return {\n      data: { handle }\x2C\n      deserializeInfo: 'internal/histogram:ClonedRecordableHistogram'\x2C\n    };\n  }\n\n  [kDeserialize]({ handle }) {\n    this[kHandle] = handle;\n  }\n}\n\nfunction ClonedHistogram(handle) {\n  const histogram = new Histogram(kSkipThrow);\n  markTransferMode(histogram\x2C true\x2C false);\n  histogram[kHandle] = handle;\n  return histogram;\n}\n\nClonedHistogram.prototype[kDeserialize] = () => { };\n\nfunction ClonedRecordableHistogram(handle) {\n  const histogram = new RecordableHistogram(kSkipThrow);\n\n  markTransferMode(histogram\x2C true\x2C false);\n  histogram[kRecordable] = true;\n  histogram[kHandle] = handle;\n  histogram.constructor = RecordableHistogram;\n\n  return histogram;\n}\n\nClonedRecordableHistogram.prototype[kDeserialize] = () => { };\n\nfunction createRecordableHistogram(handle) {\n  return new ClonedRecordableHistogram(handle);\n}\n\n/**\n * @param {{\n *   lowest? : number\x2C\n *   highest? : number\x2C\n *   figures? : number\x2C\n *   halfLife? : number\x2C\n *   threshold? : number\n * }} [options]\n * @returns {RecordableHistogram}\n */\nfunction createHistogram(options = kEmptyObject) {\n  validateObject(options\x2C 'options');\n  const {\n    lowest = 1\x2C\n    highest = NumberMAX_SAFE_INTEGER\x2C\n    figures = 3\x2C\n    halfLife = 0\x2C\n    threshold = 0\x2C\n  } = options;\n  if (typeof lowest !== 'bigint')\n    validateInteger(lowest\x2C 'options.lowest'\x2C 1\x2C NumberMAX_SAFE_INTEGER);\n  if (typeof highest !== 'bigint') {\n    validateInteger(highest\x2C 'options.highest'\x2C\n                    2 * lowest\x2C NumberMAX_SAFE_INTEGER);\n  } else if (highest < 2n * lowest) {\n    throw new ERR_INVALID_ARG_VALUE.RangeError('options.highest'\x2C highest);\n  }\n  validateInteger(figures\x2C 'options.figures'\x2C 1\x2C 5);\n  validateNumber(halfLife\x2C 'options.halfLife');\n  if (halfLife < 0)\n    throw new ERR_OUT_OF_RANGE('options.halfLife'\x2C '>= 0'\x2C halfLife);\n  validateNumber(threshold\x2C 'options.threshold');\n  if (threshold < 0)\n    throw new ERR_OUT_OF_RANGE('options.threshold'\x2C '>= 0'\x2C threshold);\n  return createRecordableHistogram(\n    new _Histogram(lowest\x2C highest\x2C figures\x2C halfLife\x2C threshold));\n}\n\nmodule.exports = {\n  Histogram\x2C\n  RecordableHistogram\x2C\n  ClonedHistogram\x2C\n  ClonedRecordableHistogram\x2C\n  isHistogram\x2C\n  kDestroy\x2C\n  kHandle\x2C\n  kSkipThrow\x2C\n  createHistogram\x2C\n};\n
