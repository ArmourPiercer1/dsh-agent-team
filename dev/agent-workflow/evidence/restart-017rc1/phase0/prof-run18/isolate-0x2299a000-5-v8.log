script-source,122,node:internal/http,'use strict';\n\nconst {\n  Date\x2C\n  Number\x2C\n  NumberParseInt\x2C\n  Symbol\x2C\n  decodeURIComponent\x2C\n} = primordials;\n\nconst { setUnrefTimeout } = require('internal/timers');\nconst { getCategoryEnabledBuffer\x2C trace } = internalBinding('trace_events');\nconst {\n  CHAR_LOWERCASE_B\x2C\n  CHAR_LOWERCASE_E\x2C\n} = require('internal/constants');\n\nconst { URL } = require('internal/url');\nconst { Buffer } = require('buffer');\nconst { isIPv4 } = require('internal/net');\nconst { ERR_PROXY_INVALID_CONFIG } = require('internal/errors').codes;\nlet utcCache;\n\nfunction utcDate() {\n  if (!utcCache) cache();\n  return utcCache;\n}\n\nfunction cache() {\n  const d = new Date();\n  utcCache = d.toUTCString();\n  setUnrefTimeout(resetCache\x2C 1000 - d.getMilliseconds());\n}\n\nfunction resetCache() {\n  utcCache = undefined;\n}\n\nlet traceEventId = 0;\n\nfunction getNextTraceEventId() {\n  return ++traceEventId;\n}\n\nconst httpEnabled = getCategoryEnabledBuffer('node.http');\n\nfunction isTraceHTTPEnabled() {\n  return httpEnabled[0] > 0;\n}\n\nconst traceEventCategory = 'node\x2Cnode.http';\n\nfunction traceBegin(...args) {\n  trace(CHAR_LOWERCASE_B\x2C traceEventCategory\x2C ...args);\n}\n\nfunction traceEnd(...args) {\n  trace(CHAR_LOWERCASE_E\x2C traceEventCategory\x2C ...args);\n}\n\nfunction ipToInt(ip) {\n  const octets = ip.split('.');\n  let result = 0;\n  for (let i = 0; i < octets.length; i++) {\n    result = (result << 8) + NumberParseInt(octets[i]);\n  }\n  // Force unsigned 32-bit result\n  return result >>> 0;\n}\n\n// There are two factors in play when proxying the request:\n// 1. What the request protocol is\x2C that is\x2C whether users are sending it via\n//    http.request or https.request\x2C or whether they are sending\n//    the request to a https:// URL or a http:// URL. HTTPS requests should be\n//    proxied by the proxy specified using the HTTPS_PROXY environment variable.\n//    HTTP requests should be proxied by the proxy specified using the HTTP_PROXY\n//    environment variable.\n// 2. What the proxy protocol is. This depends on the value of the environment variables\x2C\n//    for example.\n//\n// When proxying a HTTP request\x2C the following needs to be done:\n// https://datatracker.ietf.org/doc/html/rfc7230#section-5.3.2\n// 1. Rewrite the request path to absolute-form.\n// 2. Add proxy-connection and proxy-authorization headers appropriately.\n//\n// When proxying a HTTPS request\x2C the following needs to be done:\n// https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\n// 1. Send a CONNECT request to the proxy server.\n// 2. Wait for 200 connection established response to establish the tunnel.\n// 3. Perform TLS handshake with the endpoint through the tunnel.\n// 4. Tunnel the request using the established connection.\n//\n// When the proxy protocol is HTTP\x2C the modified HTTP request can just be sent over\n// the TCP socket to the proxy server\x2C and the HTTPS request tunnel can be established\n// over the TCP socket to the proxy server.\n// When the proxy protocol is HTTPS\x2C the modified request needs to be sent after\n// TLS handshake with the proxy server. Same goes to the HTTPS request tunnel establishment.\n\n/**\n * Represents the proxy configuration for an agent. The built-in http and https agent\n * implementation have one of this when they are configured to use a proxy.\n * @property {string} href - Proxy server URL with credentials redacted.\n * @property {string} protocol - Proxy protocol used to talk to the proxy server.\n * @property {string|undefined} auth - proxy-authorization header value\x2C if username or password is provided.\n * @property {Array<string>} bypassList - List of hosts to bypass the proxy.\n * @property {object} proxyConnectionOptions - Options for connecting to the proxy server.\n */\nclass ProxyConfig {\n  constructor(proxyUrl\x2C keepAlive\x2C noProxyList) {\n    let parsedURL;\n    try {\n      parsedURL = new URL(proxyUrl);\n    } catch {\n      throw new ERR_PROXY_INVALID_CONFIG(`Invalid proxy URL: ${proxyUrl}`);\n    }\n    const { hostname\x2C port\x2C protocol\x2C username\x2C password } = parsedURL;\n\n    if (username || password) {\n      parsedURL.username = '';\n      parsedURL.password = '';\n      this.href = parsedURL.href;\n    } else {\n      this.href = proxyUrl;\n    }\n    this.protocol = protocol;\n\n    if (username || password) {\n      // If username or password is provided\x2C prepare the proxy-authorization header.\n      const auth = `${decodeURIComponent(username)}:${decodeURIComponent(password)}`;\n      this.auth = `Basic ${Buffer.from(auth).toString('base64')}`;\n    }\n    if (noProxyList) {\n      this.bypassList = noProxyList.split('\x2C').map((entry) => entry.trim().toLowerCase());\n    } else {\n      this.bypassList = []; // No bypass list provided.\n    }\n\n    this.proxyConnectionOptions = {\n      // The host name comes from parsed URL so if it starts with '[' it must be an IPv6 address\n      // ending with ']'. Remove the brackets for net.connect().\n      host: hostname[0] === '[' ? hostname.slice(1\x2C -1) : hostname\x2C\n      // The port comes from parsed URL so it is either '' or a valid number string.\n      port: port ? Number(port) : (protocol === 'https:' ? 443 : 80)\x2C\n    };\n  }\n\n  // See: https://about.gitlab.com/blog/we-need-to-talk-no-proxy\n  // TODO(joyeecheung): share code with undici.\n  shouldUseProxy(hostname\x2C port) {\n    const bypassList = this.bypassList;\n    if (this.bypassList.length === 0) {\n      return true; // No bypass list\x2C always use the proxy.\n    }\n\n    const host = hostname.toLowerCase();\n    const hostWithPort = port ? `${host}:${port}` : host;\n\n    for (let i = 0; i < bypassList.length; i++) {\n      const entry = bypassList[i];\n\n      if (entry === '*') return false;  // * bypasses all hosts.\n      if (entry === host || entry === hostWithPort) return false;  // Matching host and host:port\n\n      // Follow curl's behavior: strip leading dot before matching suffixes.\n      if (entry[0] === '.') {\n        const suffix = entry.substring(1);\n        if (host === suffix || (host.endsWith(suffix) && host[host.length - suffix.length - 1] === '.')) return false;\n      }\n\n      // Handle wildcards like *.example.com\n      if (entry.startsWith('*.') && host.endsWith(entry.substring(1))) return false;\n\n      // Handle IP ranges (simple format like 192.168.1.0-192.168.1.255)\n      // TODO(joyeecheung): support IPv6.\n      if (entry.includes('-') && isIPv4(host)) {\n        let { 0: startIP\x2C 1: endIP } = entry.split('-');\n        startIP = startIP.trim();\n        endIP = endIP.trim();\n        if (startIP && endIP && isIPv4(startIP) && isIPv4(endIP)) {\n          const hostInt = ipToInt(host);\n          const startInt = ipToInt(startIP);\n          const endInt = ipToInt(endIP);\n          if (hostInt >= startInt && hostInt <= endInt) return false;\n        }\n      }\n\n      // It might be useful to support CIDR notation\x2C but it's not so widely supported\n      // in other tools as a de-facto standard to follow\x2C so we don't implement it for now.\n    }\n\n    return true; // If no matches found\x2C use the proxy.\n  }\n}\n\nfunction parseProxyUrl(env\x2C protocol) {\n  // Get the proxy url - following the most popular convention\x2C lower case takes precedence.\n  // See https://about.gitlab.com/blog/we-need-to-talk-no-proxy/#http_proxy-and-https_proxy\n  const proxyUrl = (protocol === 'https:') ?\n    (env.https_proxy || env.HTTPS_PROXY) : (env.http_proxy || env.HTTP_PROXY);\n  // No proxy settings from the environment\x2C ignore.\n  if (!proxyUrl) {\n    return null;\n  }\n\n  if (proxyUrl.includes('\\r') || proxyUrl.includes('\\n')) {\n    throw new ERR_PROXY_INVALID_CONFIG(`Invalid proxy URL: ${proxyUrl}`);\n  }\n\n  return proxyUrl;\n}\n\nfunction parseProxyConfigFromEnv(env\x2C protocol\x2C keepAlive) {\n  // We only support proxying for HTTP and HTTPS requests.\n  if (protocol !== 'http:' && protocol !== 'https:') {\n    return null;\n  }\n\n  const proxyUrl = parseProxyUrl(env\x2C protocol);\n  if (proxyUrl === null) {\n    return null;\n  }\n\n  // Only http:// and https:// proxies are supported.\n  // Ignore instead of throw\x2C in case other protocols are supposed to be\n  // handled by the user land.\n  if (!proxyUrl.startsWith('http://') && !proxyUrl.startsWith('https://')) {\n    return null;\n  }\n\n  const noProxyList = env.no_proxy || env.NO_PROXY;\n  return new ProxyConfig(proxyUrl\x2C keepAlive\x2C noProxyList);\n}\n\n/**\n * @param {ProxyConfig} proxyConfig\n * @param {object} reqOptions\n * @returns {boolean}\n */\nfunction checkShouldUseProxy(proxyConfig\x2C reqOptions) {\n  if (!proxyConfig) {\n    return false;\n  }\n  if (reqOptions.socketPath) {\n    // If socketPath is set\x2C the endpoint is a Unix domain socket\x2C which can't\n    // be proxied.\n    return false;\n  }\n  return proxyConfig.shouldUseProxy(reqOptions.host || 'localhost'\x2C reqOptions.port);\n}\n\nfunction filterEnvForProxies(env) {\n  return {\n    __proto__: null\x2C\n    http_proxy: env.http_proxy\x2C\n    HTTP_PROXY: env.HTTP_PROXY\x2C\n    https_proxy: env.https_proxy\x2C\n    HTTPS_PROXY: env.HTTPS_PROXY\x2C\n    no_proxy: env.no_proxy\x2C\n    NO_PROXY: env.NO_PROXY\x2C\n  };\n}\n\nfunction getGlobalAgent(proxyEnv\x2C Agent) {\n  return new Agent({\n    keepAlive: true\x2C scheduling: 'lifo'\x2C timeout: 5000\x2C\n    proxyEnv\x2C\n  });\n}\n\nmodule.exports = {\n  kOutHeaders: Symbol('kOutHeaders')\x2C\n  kNeedDrain: Symbol('kNeedDrain')\x2C\n  kProxyConfig: Symbol('kProxyConfig')\x2C\n  kWaitForProxyTunnel: Symbol('kWaitForProxyTunnel')\x2C\n  checkShouldUseProxy\x2C\n  parseProxyConfigFromEnv\x2C\n  utcDate\x2C\n  traceBegin\x2C\n  traceEnd\x2C\n  getNextTraceEventId\x2C\n  isTraceHTTPEnabled\x2C\n  filterEnvForProxies\x2C\n  getGlobalAgent\x2C\n  parseProxyUrl\x2C\n};\n
