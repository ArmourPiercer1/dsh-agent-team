script-source,4,node:internal/per_context/domexception,'use strict';\n\nconst {\n  Error\x2C\n  ErrorPrototype\x2C\n  ObjectDefineProperties\x2C\n  ObjectDefineProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  SafeMap\x2C\n  SafeSet\x2C\n  SafeWeakMap\x2C\n  SymbolToStringTag\x2C\n  TypeError\x2C\n} = primordials;\nconst {\n  transfer_mode_private_symbol\x2C\n} = privateSymbols;\nconst {\n  messaging_clone_symbol\x2C\n  messaging_deserialize_symbol\x2C\n} = perIsolateSymbols;\n\n/**\n * Maps to BaseObject::TransferMode::kCloneable\n */\nconst kCloneable = 2;\n\nfunction throwInvalidThisError(Base\x2C type) {\n  const err = new Base();\n  const key = 'ERR_INVALID_THIS';\n  ObjectDefineProperties(err\x2C {\n    message: {\n      __proto__: null\x2C\n      value: `Value of "this" must be of ${type}`\x2C\n      enumerable: false\x2C\n      writable: true\x2C\n      configurable: true\x2C\n    }\x2C\n    toString: {\n      __proto__: null\x2C\n      value: function toString() {\n        return `${this.name} [${key}]: ${this.message}`;\n      }\x2C\n      enumerable: false\x2C\n      writable: true\x2C\n      configurable: true\x2C\n    }\x2C\n  });\n  err.code = key;\n  throw err;\n}\n\nconst internalsMap = new SafeWeakMap();\nconst nameToCodeMap = new SafeMap();\n\n// These were removed from the error names table.\n// See https://github.com/heycam/webidl/pull/946.\nconst disusedNamesSet = new SafeSet()\n  .add('DOMStringSizeError')\n  .add('NoDataAllowedError')\n  .add('ValidationError');\n\n// The DOMException WebIDL interface defines that:\n// - ObjectGetPrototypeOf(DOMException) === Function.\n// - ObjectGetPrototypeOf(DOMException.prototype) === Error.prototype.\n// Thus\x2C we can not simply use the pattern of `class DOMException extends Error` and call\n// `super()` to construct an object. The `super` in `super()` call in the constructor will\n// be resolved to `Function`\x2C instead of `Error`. Use the trick of return overriding to\n// create an object with the `[[ErrorData]]` internal slot.\n// Ref: https://tc39.es/ecma262/multipage/ecmascript-language-expressions.html#sec-getsuperconstructor\nclass DOMException {\n  constructor(message = ''\x2C options = 'Error') {\n    // Invokes the Error constructor to create an object with the [[ErrorData]]\n    // internal slot.\n    // eslint-disable-next-line no-restricted-syntax\n    const self = new Error();\n    // Use `new.target.prototype` to support DOMException subclasses.\n    ObjectSetPrototypeOf(self\x2C new.target.prototype);\n    self[transfer_mode_private_symbol] = kCloneable;\n\n    if (options && typeof options === 'object') {\n      const { name } = options;\n      internalsMap.set(self\x2C {\n        message: `${message}`\x2C\n        name: `${name}`\x2C\n      });\n\n      if ('cause' in options) {\n        ObjectDefineProperty(self\x2C 'cause'\x2C {\n          __proto__: null\x2C\n          value: options.cause\x2C\n          configurable: true\x2C\n          writable: true\x2C\n          enumerable: false\x2C\n        });\n      }\n    } else {\n      internalsMap.set(self\x2C {\n        message: `${message}`\x2C\n        name: `${options}`\x2C\n      });\n    }\n    // Return the error object as the return overriding of the constructor.\n    // eslint-disable-next-line no-constructor-return\n    return self;\n  }\n\n  [messaging_clone_symbol]() {\n    // See serialization steps in https://webidl.spec.whatwg.org/#dom-domexception-domexception\n    const internals = internalsMap.get(this);\n    return {\n      data: {\n        message: internals.message\x2C\n        name: internals.name\x2C\n        stack: this.stack\x2C\n      }\x2C\n      deserializeInfo: 'internal/worker/clone_dom_exception:DOMException'\x2C\n    };\n  }\n\n  [messaging_deserialize_symbol](data) {\n    // See deserialization steps in https://webidl.spec.whatwg.org/#dom-domexception-domexception\n    internalsMap.set(this\x2C {\n      message: data.message\x2C\n      name: data.name\x2C\n    });\n   