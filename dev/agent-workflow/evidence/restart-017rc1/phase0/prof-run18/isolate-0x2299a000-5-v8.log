script-source,140,node:internal/crypto/keys,'use strict';\n\nconst {\n  ArrayPrototypeSlice\x2C\n  ObjectDefineProperties\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  StringPrototypeIncludes\x2C\n  StringPrototypeStartsWith\x2C\n  SymbolToStringTag\x2C\n  Uint8Array\x2C\n} = primordials;\n\nconst {\n  KeyObjectHandle\x2C\n  createNativeKeyObjectClass\x2C\n  // eslint-disable-next-line no-restricted-syntax -- intended here\n  getKeyObjectSlots: nativeGetKeyObjectSlots\x2C\n  createCryptoKeyClass\x2C\n  // eslint-disable-next-line no-restricted-syntax -- intended here\n  getCryptoKeySlots: nativeGetCryptoKeySlots\x2C\n  kKeyTypeSecret\x2C\n  kKeyTypePublic\x2C\n  kKeyTypePrivate\x2C\n  kKeyFormatPEM\x2C\n  kKeyFormatDER\x2C\n  kKeyFormatJWK\x2C\n  kKeyFormatRawPublic\x2C\n  kKeyFormatRawPrivate\x2C\n  kKeyFormatRawSeed\x2C\n  kKeyFormatStore\x2C\n  kKeyEncodingPKCS1\x2C\n  kKeyEncodingPKCS8\x2C\n  kKeyEncodingSPKI\x2C\n  kKeyEncodingSEC1\x2C\n} = internalBinding('crypto');\n\nconst {\n  crypto: {\n    POINT_CONVERSION_COMPRESSED\x2C\n    POINT_CONVERSION_UNCOMPRESSED\x2C\n  }\x2C\n} = internalBinding('constants');\n\nconst {\n  validateObject\x2C\n  validateOneOf\x2C\n  validateString\x2C\n} = require('internal/validators');\n\nconst {\n  codes: {\n    ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS\x2C\n    ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE\x2C\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_ARG_TYPE\x2C\n    ERR_INVALID_ARG_VALUE\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  getArrayBufferOrView\x2C\n  bigIntArrayToUnsignedBigInt\x2C\n  normalizeAlgorithm\x2C\n  hasAnyNotIn\x2C\n  getUsagesMask\x2C\n  getUsagesFromMask\x2C\n  hasUsage\x2C\n  toUsagesSet\x2C\n} = require('internal/crypto/util');\n\nconst {\n  isAnyArrayBuffer\x2C\n  isArrayBufferView\x2C\n} = require('internal/util/types');\n\nconst {\n  fileURLToPath\x2C\n  getURLHref\x2C\n  isURLInstance\x2C\n} = require('internal/url');\n\nconst {\n  customInspectSymbol: kInspect\x2C\n  getDeprecationWarningEmitter\x2C\n  kEnumerableProperty\x2C\n  kEmptyObject\x2C\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst { inspect } = require('internal/util/inspect');\n\nconst emitDEP0203 = getDeprecationWarningEmitter(\n  'DEP0203'\x2C\n  'Passing a CryptoKey to node:crypto functions is deprecated.'\x2C\n);\n\nconst maybeEmitDEP0204 = getDeprecationWarningEmitter(\n  'DEP0204'\x2C\n  'Passing a non-extractable CryptoKey to KeyObject.from() is deprecated.'\x2C\n  undefined\x2C\n  false\x2C\n  (key) => !getCryptoKeyExtractable(key)\x2C\n);\n\n// Key input contexts.\nconst kConsumePublic = 0;\nconst kConsumePrivate = 1;\nconst kCreatePublic = 2;\nconst kCreatePrivate = 3;\n\nconst encodingNames = [];\nfor (const m of [[kKeyEncodingPKCS1\x2C 'pkcs1']\x2C [kKeyEncodingPKCS8\x2C 'pkcs8']\x2C\n                 [kKeyEncodingSPKI\x2C 'spki']\x2C [kKeyEncodingSEC1\x2C 'sec1']])\n  encodingNames[m[0]] = m[1];\n\n// KeyObject state lives on the native NativeKeyObject base class. JS reads\n// the native type enum and a KeyObjectHandle in one call and caches that\n// slot tuple in a private field so no forgeable own Symbols are exposed on\n// public KeyObject instances.\nlet getKeyObjectSlots; // Populated by the createNativeKeyObjectClass callback.\n\nconst kKeyObjectSlotType = 0;\nconst kKeyObjectSlotHandle = 1;\n// The native slot tuple stops at kKeyObjectSlotHandle. The remaining entries\n// are JS-side lazy cache slots derived from the KeyObjectHandle on first use.\nconst kKeyObjectSlotSymmetricKeySize = 2;\nconst kKeyObjectSlotAsymmetricKeyType = 3;\nconst kKeyObjectSlotAsymmetricKeyDetails = 4;\n\nfunction normalizeKeyDetails(details = kEmptyObject) {\n  if (details.publicExponent !== undefined) {\n    return {\n      __proto__: null\x2C\n      ...details\x2C\n      publicExponent:\n        bigIntArrayToUnsignedBigInt(new Uint8Array(details.publicExponent))\x2C\n    };\n  }\n  return details;\n}\n\n// Creating the KeyObject class is a little complicated due to inheritance\n// and the fact that KeyObjects should be transferable between threads\x2C\n// which requires the KeyObject base class to be implemented in C++.\n// The creation requires a callback to make sure that the NativeKeyObject\n// base class cannot exist without the other KeyObject implementations.\nconst {\n  0: KeyObject\x2C\n  1: SecretKeyObject\x2C\n  2: PublicKeyObject\x2C\n  3: PrivateKeyObject\x2C\n} = createNativeKeyObjectClass((NativeKeyObject) => {\n  let webidl;\n\n  // Publicly visible KeyObject class.\n  class KeyObject extends NativeKeyObject {\n    #slots;\n\n    constructor(type\x2C handle) {\n      if (type !== 'secret' && type !== 'public' && type !== 'private')\n        throw new ERR_INVALID_ARG_VALUE('type'\x2C type);\n      if (typeof handle !== 'object' || !(handle instanceof KeyObjectHandle))\n        throw new ERR_INVALID_ARG_TYPE('handle'\x2C 'object'\x2C handle);\n\n      super(handle);\n    }\n\n    get type() {\n      return getKeyObjectType(this);\n    }\n\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\n      webidl ??= require('internal/crypto/webidl');\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\n      extractable = webidl.converters.boolean(extractable);\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\n\n      const type = getKeyObjectType(this);\n      const handle = getKeyObjectHandle(this);\n      switch (type) {\n        case 'secret':\n          return toCryptoKeySecret(\n            handle\x2C\n            algorithm\x2C\n            extractable\x2C\n            keyUsages);\n        case 'public':\n          // Fall through\n        case 'private':\n          return toCryptoKey(\n            handle\x2C\n            algorithm\x2C\n            extractable\x2C\n            keyUsages);\n      }\n    }\n\n    static from(key) {\n      if (!isCryptoKey(key))\n        throw new ERR_INVALID_ARG_TYPE('key'\x2C 'CryptoKey'\x2C key);\n      maybeEmitDEP0204(key);\n      const handle = getCryptoKeyHandle(key);\n      switch (getCryptoKeyType(key)) {\n        /* eslint-disable no-use-before-define */\n        case 'secret': return new SecretKeyObject(handle);\n        case 'public': return new PublicKeyObject(handle);\n        case 'private': return new PrivateKeyObject(handle);\n        /* eslint-enable no-use-before-define */\n      }\n    }\n\n    equals(otherKeyObject) {\n      if (!isKeyObject(otherKeyObject)) {\n        throw new ERR_INVALID_ARG_TYPE(\n          'otherKeyObject'\x2C 'KeyObject'\x2C otherKeyObject);\n      }\n\n      const slots = getKeyObjectSlots(this);\n      const otherSlots = getKeyObjectSlots(otherKeyObject);\n      return slots[kKeyObjectSlotType] === otherSlots[kKeyObjectSlotType] &&\n        slots[kKeyObjectSlotHandle].equals(\n          otherSlots[kKeyObjectSlotHandle]);\n    }\n\n    static {\n      getKeyObjectSlots = (key) => {\n        if (!key || typeof key !== 'object')\n          throw new ERR_INVALID_THIS('KeyObject');\n        if (#slots in key) {\n          const cached = key.#slots;\n          if (cached !== undefined) return cached;\n        }\n        const slots = nativeGetKeyObjectSlots(key);\n        key.#slots = slots;\n        return slots;\n      };\n    }\n  }\n\n  ObjectDefineProperties(KeyObject.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      configurable: true\x2C\n      value: 'KeyObject'\x2C\n    }\x2C\n  });\n\n  class SecretKeyObject extends KeyObject {\n    constructor(handle) {\n      super('secret'\x2C handle);\n    }\n\n    get symmetricKeySize() {\n      return getKeyObjectSymmetricKeySize(this);\n    }\n\n    export(options) {\n      const handle = getKeyObjectHandle(this);\n      if (options !== undefined) {\n        validateObject(options\x2C 'options');\n        validateOneOf(\n          options.format\x2C 'options.format'\x2C [undefined\x2C 'buffer'\x2C 'jwk']);\n        if (options.format === 'jwk') {\n          return handle.exportJwk({}\x2C false);\n        }\n      }\n      return handle.export();\n    }\n  }\n\n  class AsymmetricKeyObject extends KeyObject {\n    get asymmetricKeyType() {\n      return getKeyObjectAsymmetricKeyType(this);\n    }\n\n    get asymmetricKeyDetails() {\n      return { ...getKeyObjectAsymmetricKeyDetails(this) };\n    }\n  }\n\n  class PublicKeyObject extends AsymmetricKeyObject {\n    constructor(handle) {\n      super('public'\x2C handle);\n    }\n\n    export(options) {\n      switch (options?.format) {\n        case 'jwk':\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\n        case 'raw-public': {\n          const handle = getKeyObjectHandle(this);\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          if (asymmetricKeyType === 'ec') {\n            const { type = 'uncompressed' } = options;\n            validateOneOf(type\x2C 'options.type'\x2C ['compressed'\x2C 'uncompressed']);\n            const form = type === 'compressed' ?\n              POINT_CONVERSION_COMPRESSED : POINT_CONVERSION_UNCOMPRESSED;\n            return handle.exportECPublicRaw(form);\n          }\n          return handle.rawPublicKey();\n        }\n        default: {\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          const handle = getKeyObjectHandle(this);\n          const {\n            format\x2C\n            type\x2C\n          } = parsePublicKeyEncoding(options\x2C asymmetricKeyType);\n          return handle.export(format\x2C type);\n        }\n      }\n    }\n  }\n\n  class PrivateKeyObject extends AsymmetricKeyObject {\n    constructor(handle) {\n      super('private'\x2C handle);\n    }\n\n    export(options) {\n      if (options?.passphrase !== undefined &&\n          options.format !== 'pem' && options.format !== 'der') {\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n          options.format\x2C 'does not support encryption');\n      }\n      switch (options?.format) {\n        case 'jwk':\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\n        case 'raw-private': {\n          const handle = getKeyObjectHandle(this);\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          if (asymmetricKeyType === 'ec') {\n            return handle.exportECPrivateRaw();\n          }\n          return handle.rawPrivateKey();\n        }\n        case 'raw-seed':\n          return getKeyObjectHandle(this).rawSeed();\n        default: {\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\n          const handle = getKeyObjectHandle(this);\n          const {\n            format\x2C\n            type\x2C\n            cipher\x2C\n            passphrase\x2C\n          } = parsePrivateKeyEncoding(options\x2C asymmetricKeyType);\n          return handle.export(format\x2C type\x2C cipher\x2C passphrase);\n        }\n      }\n    }\n  }\n\n  return [KeyObject\x2C SecretKeyObject\x2C PublicKeyObject\x2C PrivateKeyObject];\n});\n\nfunction parseKeyFormat(formatStr\x2C defaultFormat\x2C optionName) {\n  if (formatStr === undefined && defaultFormat !== undefined)\n    return defaultFormat;\n  else if (formatStr === 'pem')\n    return kKeyFormatPEM;\n  else if (formatStr === 'der')\n    return kKeyFormatDER;\n  else if (formatStr === 'jwk')\n    return kKeyFormatJWK;\n  else if (formatStr === 'raw-public')\n    return kKeyFormatRawPublic;\n  else if (formatStr === 'raw-private')\n    return kKeyFormatRawPrivate;\n  else if (formatStr === 'raw-seed')\n    return kKeyFormatRawSeed;\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C formatStr);\n}\n\nfunction parseKeyType(typeStr\x2C required\x2C keyType\x2C isPublic\x2C optionName) {\n  if (typeStr === undefined && !required) {\n    return undefined;\n  } else if (typeStr === 'pkcs1') {\n    if (keyType !== undefined && keyType !== 'rsa') {\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n        typeStr\x2C 'can only be used for RSA keys');\n    }\n    return kKeyEncodingPKCS1;\n  } else if (typeStr === 'spki' && isPublic !== false) {\n    return kKeyEncodingSPKI;\n  } else if (typeStr === 'pkcs8' && isPublic !== true) {\n    return kKeyEncodingPKCS8;\n  } else if (typeStr === 'sec1' && isPublic !== true) {\n    if (keyType !== undefined && keyType !== 'ec') {\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n        typeStr\x2C 'can only be used for EC keys');\n    }\n    return kKeyEncodingSEC1;\n  }\n\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C typeStr);\n}\n\nfunction option(name\x2C prefix) {\n  return prefix === undefined ?\n    `options.${name}` : `${prefix}.${name}`;\n}\n\nfunction parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName) {\n  const { format: formatStr\x2C type: typeStr } = enc;\n\n  const isInput = keyType === undefined;\n  const format = parseKeyFormat(formatStr\x2C\n                                isInput ? kKeyFormatPEM : undefined\x2C\n                                option('format'\x2C objName));\n\n  if (format === kKeyFormatRawPublic) {\n    if (isPublic === false) {\n      throw new ERR_INVALID_ARG_VALUE(option('format'\x2C objName)\x2C 'raw-public');\n    }\n    let type;\n    if (typeStr === undefined || typeStr === 'uncompressed') {\n      type = POINT_CONVERSION_UNCOMPRESSED;\n    } else if (typeStr === 'compressed') {\n      type = POINT_CONVERSION_COMPRESSED;\n    } else {\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\n    }\n    return { format\x2C type };\n  }\n\n  if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\n    if (isPublic === true) {\n      throw new ERR_INVALID_ARG_VALUE(\n        option('format'\x2C objName)\x2C\n        format === kKeyFormatRawPrivate ? 'raw-private' : 'raw-seed');\n    }\n    if (typeStr !== undefined) {\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\n    }\n    return { format };\n  }\n\n  const isRequired = (!isInput ||\n                      format === kKeyFormatDER) &&\n                      format !== kKeyFormatJWK;\n  const type = parseKeyType(typeStr\x2C\n                            isRequired\x2C\n                            keyType\x2C\n                            isPublic\x2C\n                            option('type'\x2C objName));\n  return { format\x2C type };\n}\n\nfunction isStringOrBuffer(val) {\n  return typeof val === 'string' ||\n         isArrayBufferView(val) ||\n         isAnyArrayBuffer(val);\n}\n\nfunction parseKeyEncoding(enc\x2C keyType\x2C isPublic\x2C objName) {\n  validateObject(enc\x2C 'options');\n\n  const isInput = keyType === undefined;\n\n  const {\n    format\x2C\n    type\x2C\n  } = parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName);\n\n  let cipher\x2C passphrase\x2C encoding;\n  if (isPublic !== true) {\n    ({ cipher\x2C passphrase\x2C encoding } = enc);\n\n    if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\n      if (cipher != null || passphrase !== undefined) {\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n          'raw format'\x2C 'does not support encryption');\n      }\n      return { format\x2C type };\n    }\n\n    if (!isInput) {\n      if (cipher != null) {\n        if (typeof cipher !== 'string')\n          throw new ERR_INVALID_ARG_VALUE(option('cipher'\x2C objName)\x2C cipher);\n        if (format === kKeyFormatDER &&\n            (type === kKeyEncodingPKCS1 ||\n             type === kKeyEncodingSEC1)) {\n          throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\n            encodingNames[type]\x2C 'does not support encryption');\n        }\n      } else if (passphrase !== undefined) {\n        throw new ERR_INVALID_ARG_VALUE(\n          option('cipher'\x2C objName)\x2C cipher\x2C\n          'is required when a passphrase is specified');\n      }\n    }\n\n    if ((isInput && passphrase !== undefined &&\n         !isStringOrBuffer(passphrase)) ||\n        (!isInput && cipher != null && !isStringOrBuffer(passphrase))) {\n      throw new ERR_INVALID_ARG_VALUE(option('passphrase'\x2C objName)\x2C\n                                      passphrase);\n    }\n  }\n\n  if (passphrase !== undefined)\n    passphrase = getArrayBufferOrView(passphrase\x2C 'key.passphrase'\x2C encoding);\n\n  return { format\x2C type\x2C cipher\x2C passphrase };\n}\n\n// Parses the public key encoding based on an object. keyType must be undefined\n// when this is used to parse an input encoding and must be a valid key type if\n// used to parse an output encoding.\nfunction parsePublicKeyEncoding(enc\x2C keyType\x2C objName) {\n  return parseKeyEncoding(enc\x2C keyType\x2C keyType ? true : undefined\x2C objName);\n}\n\n// Parses the private key encoding based on an object. keyType must be undefined\n// when this is used to parse an input encoding and must be a valid key type if\n// used to parse an output encoding.\nfunction parsePrivateKeyEncoding(enc\x2C keyType\x2C objName) {\n  return parseKeyEncoding(enc\x2C keyType\x2C false\x2C objName);\n}\n\nfunction validateAsymmetricKeyType(type\x2C ctx\x2C key) {\n  if (ctx === kCreatePrivate) {\n    throw new ERR_INVALID_ARG_TYPE(\n      'key'\x2C\n      getKeyTypes({ allowKeyObject: false\x2C allowURL: true })\x2C\n      key\x2C\n    );\n  }\n\n  if (type !== 'private') {\n    if (ctx === kConsumePrivate || ctx === kCreatePublic)\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'private');\n    if (type !== 'public') {\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C\n                                                   'private or public');\n    }\n  }\n}\n\nconst kKeyTypesBufferOnly = [\n  'ArrayBuffer'\x2C\n  'Buffer'\x2C\n  'TypedArray'\x2C\n  'DataView'\x2C\n];\n\nfunction getKeyTypes({ allowKeyObject\x2C allowURL = false }) {\n  return [\n    ...kKeyTypesBufferOnly\x2C\n    'string'\x2C\n    ...(allowKeyObject ? ['KeyObject'\x2C 'CryptoKey'] : [])\x2C\n    ...(allowURL ? ['URL'] : [])\x2C\n  ];\n}\n\nfunction prepareStorePrivateKey(url\x2C name\x2C passphrase\x2C encoding\x2C properties) {\n  // Read the canonical serialization from private URL state. Public accessors\n  // can be overridden by subclasses or through prototype mutation.\n  let uri = getURLHref(url);\n  if (StringPrototypeStartsWith(uri\x2C 'file:'))\n    uri = fileURLToPath(uri);\n\n  validateString(uri\x2C name);\n  // The URI is handed to OpenSSL as a NUL-terminated C string. Reject embedded\n  // NUL bytes\x2C which `fileURLToPath()` happily decodes from `%00`\x2C rather than\n  // letting the URI be silently truncated.\n  if (StringPrototypeIncludes(uri\x2C '\\u0000')) {\n    throw new ERR_INVALID_ARG_VALUE(\n      name\x2C url\x2C 'must be a URL without null bytes');\n  }\n\n  if (passphrase !== undefined) {\n    if (!isStringOrBuffer(passphrase)) {\n      throw new ERR_INVALID_ARG_VALUE(option('passphrase'\x2C name)\x2C passphrase);\n    }\n    passphrase = getArrayBufferOrView(\n      passphrase\x2C\n      option('passphrase'\x2C name)\x2C\n      encoding);\n  }\n\n  if (properties !== undefined) {\n    validateString(properties\x2C option('properties'\x2C name));\n    // Reaches OpenSSL as a NUL-terminated C string\x2C same as the URI above.\n    if (StringPrototypeIncludes(properties\x2C '\\u0000')) {\n      throw new ERR_INVALID_ARG_VALUE(\n        option('properties'\x2C name)\x2C\n        properties\x2C\n        'must be a string without null bytes');\n    }\n  }\n\n  return {\n    data: {\n      uri\x2C\n      properties: properties ?? null\x2C\n    }\x2C\n    format: kKeyFormatStore\x2C\n    passphrase: passphrase ?? null\x2C\n  };\n}\n\nfunction prepareAsymmetricKey(key\x2C ctx\x2C name = 'key') {\n  const isPrivateKeyInput = ctx === kConsumePrivate || ctx === kCreatePrivate;\n\n  if (isKeyObject(key)) {\n    // Best case: A key object\x2C as simple as that.\n    const type = getKeyObjectType(key);\n    validateAsymmetricKeyType(type\x2C ctx\x2C key);\n    return { data: getKeyObjectHandle(key) };\n  }\n  if (isCryptoKey(key)) {\n    emitDEP0203();\n    validateAsymmetricKeyType(getCryptoKeyType(key)\x2C ctx\x2C key);\n    return { data: getCryptoKeyHandle(key) };\n  }\n  if (isPrivateKeyInput && isURLInstance(key)) {\n    // A private key referenced by a URI for an OpenSSL STORE loader.\n    return prepareStorePrivateKey(key\x2C name);\n  }\n  if (isStringOrBuffer(key)) {\n    // Expect PEM by default\x2C mostly for backward compatibility.\n    return { format: kKeyFormatPEM\x2C data: getArrayBufferOrView(key\x2C name) };\n  }\n  if (typeof key === 'object') {\n    const { key: data\x2C encoding\x2C format\x2C properties } = key;\n\n    // The 'key' property can be a KeyObject as well to allow specifying\n    // additional options such as padding along with the key.\n    if (isKeyObject(data)) {\n      const type = getKeyObjectType(data);\n      validateAsymmetricKeyType(type\x2C ctx\x2C data);\n      return { data: getKeyObjectHandle(data) };\n    }\n    if (isCryptoKey(data)) {\n      emitDEP0203();\n      validateAsymmetricKeyType(getCryptoKeyType(data)\x2C ctx\x2C data);\n      return { data: getCryptoKeyHandle(data) };\n    }\n    if (isPrivateKeyInput && isURLInstance(data)) {\n      // A private key referenced by a URI for an OpenSSL STORE loader\x2C with\n      // an optional passphrase/PIN.\n      return prepareStorePrivateKey(\n        data\x2C\n        name\x2C\n        key.passphrase\x2C\n        encoding\x2C\n        properties);\n    }\n    if (format === 'jwk') {\n      validateObject(data\x2C `${name}.key`);\n      return { data\x2C format: kKeyFormatJWK };\n    } else if (format === 'raw-public' || format === 'raw-private' ||\n               format === 'raw-seed') {\n      if ((ctx === kConsumePrivate || ctx === kCreatePrivate) &&\n          format === 'raw-public') {\n        throw new ERR_INVALID_ARG_VALUE(`${name}.format`\x2C format);\n      }\n      if (!isArrayBufferView(data) && !isAnyArrayBuffer(data)) {\n        throw new ERR_INVALID_ARG_TYPE(\n          `${name}.key`\x2C\n          ['ArrayBuffer'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\n          data);\n      }\n      validateString(key.asymmetricKeyType\x2C `${name}.asymmetricKeyType`);\n      if (key.asymmetricKeyType === 'ec') {\n        validateString(key.namedCurve\x2C `${name}.namedCurve`);\n      }\n      const rawFormat = parseKeyFormat(format\x2C undefined\x2C `${name}.format`);\n      return {\n        data: getArrayBufferOrView(data\x2C `${name}.key`)\x2C\n        format: rawFormat\x2C\n        type: key.asymmetricKeyType\x2C\n        namedCurve: key.namedCurve ?? null\x2C\n      };\n    }\n\n    // Either PEM or DER using PKCS#1 or SPKI.\n    if (!isStringOrBuffer(data)) {\n      throw new ERR_INVALID_ARG_TYPE(\n        `${name}.key`\x2C\n        getKeyTypes({\n          allowKeyObject: ctx !== kCreatePrivate\x2C\n          allowURL: isPrivateKeyInput\x2C\n        })\x2C\n        data);\n    }\n\n    const isPublic =\n      (ctx === kConsumePrivate || ctx === kCreatePrivate) ? false : undefined;\n    return {\n      data: getArrayBufferOrView(data\x2C `${name}.key`\x2C encoding)\x2C\n      ...parseKeyEncoding(key\x2C undefined\x2C isPublic\x2C name)\x2C\n    };\n  }\n\n  throw new ERR_INVALID_ARG_TYPE(\n    name\x2C\n    getKeyTypes({\n      allowKeyObject: ctx !== kCreatePrivate\x2C\n      allowURL: isPrivateKeyInput\x2C\n    })\x2C\n    key);\n}\n\nfunction preparePrivateKey(key\x2C name) {\n  return prepareAsymmetricKey(key\x2C kConsumePrivate\x2C name);\n}\n\nfunction preparePublicOrPrivateKey(key\x2C name) {\n  return prepareAsymmetricKey(key\x2C kConsumePublic\x2C name);\n}\n\nfunction prepareSecretKey(key\x2C encoding\x2C bufferOnly = false) {\n  if (!bufferOnly) {\n    if (isKeyObject(key)) {\n      const type = getKeyObjectType(key);\n      if (type !== 'secret')\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\n      return getKeyObjectHandle(key);\n    }\n    if (isCryptoKey(key)) {\n      emitDEP0203();\n      const type = getCryptoKeyType(key);\n      if (type !== 'secret')\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\n      return getCryptoKeyHandle(key);\n    }\n  }\n  if (typeof key !== 'string' &&\n      !isArrayBufferView(key) &&\n      !isAnyArrayBuffer(key)) {\n    throw new ERR_INVALID_ARG_TYPE(\n      'key'\x2C\n      bufferOnly ? kKeyTypesBufferOnly : getKeyTypes({ allowKeyObject: true })\x2C\n      key);\n  }\n  return getArrayBufferOrView(key\x2C 'key'\x2C encoding);\n}\n\nfunction createSecretKey(key\x2C encoding) {\n  key = prepareSecretKey(key\x2C encoding\x2C true);\n  const handle = new KeyObjectHandle();\n  handle.init(kKeyTypeSecret\x2C key);\n  return new SecretKeyObject(handle);\n}\n\nfunction createPublicKey(key) {\n  const { format\x2C type\x2C data\x2C passphrase\x2C namedCurve } =\n    prepareAsymmetricKey(key\x2C kCreatePublic);\n  const handle = new KeyObjectHandle();\n  handle.init(kKeyTypePublic\x2C data\x2C format ?? null\x2C\n              type ?? null\x2C passphrase ?? null\x2C namedCurve ?? null);\n  return new PublicKeyObject(handle);\n}\n\n/**\n * Converts a secret KeyObjectHandle to a CryptoKey by dispatching to the\n * algorithm-specific Web Crypto import path.\n * @param {KeyObjectHandle} keyData\n * @param {object} algorithm\n * @param {boolean} extractable\n * @param {string[]} keyUsages\n * @returns {CryptoKey}\n */\nfunction toCryptoKeySecret(\n  keyData\x2C\n  algorithm\x2C\n  extractable\x2C\n  keyUsages\x2C\n) {\n  let result;\n  switch (algorithm.name) {\n    case 'HMAC':\n      // Fall through\n    case 'KMAC128':\n      // Fall through\n    case 'KMAC256':\n      result = require('internal/crypto/mac')\n        .macImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall thr