script-source,185,file:///home/user/dsh-plugins/dsh-agent-team/dev/agent-workflow/evidence/restart-017rc1/phase0/spike.mjs,#!/usr/bin/env node\n/**\n * spike.mjs \u2014 Phase 0 real-host characterization spike for the 0.1.7-rc.1\n * Team restart-recovery fix (guide `dsh-agent-team-restart-recovery-0.1.7-rc.1-guide.md`\n * \xa79; Commit 1 = characterization only\x2C NO production changes).\n *\n * Answers the two guide questions:\n *\n *   Q1  Does a rejected `agent/created` (the C1 fence veto) really release\n *       the session writer? (rollback: write handle close \u2192 agent/disposed \u2192\n *       the Team's own `agents.resume` succeeds afterwards\x2C with zero model\n *       requests made by the foreign agent and a fully intact session log.)\n *\n *   Q2  Does the intentional rejection surface a PERSISTENT user-visible\n *       `api-session/error` in the browser? (wire-level capture here; the\n *       browser leg is a manual step while `--keep` holds boot 3 alive \u2014\n *       see the keep-mode.json evidence and the session report.)\n *\n * Legs (one fresh world under tests/homes/\x2C git-install of the task branch\x2C\n * mock model\x2C cookie-gated REST + the /api/remote.mux WebSocket protocol):\n *\n *   Leg A   (baseline\x2C CURRENT production code): boot 1 (bootPhase create) \u2192\n *           team.create dynamic root R1 \u2192 leader live (model request seen) \u2192\n *           stop. Boot 2 (bootPhase resume): the dynamic root is COLD.\n *           Browser-equivalent `session/follow`(R1) over the stream carrier\n *           triggers the stock ordinary promotion (agent/created source=\n *           resume\x2C unvetoed by the passive probe). Then\n *           `team.ensureRootLive`(R1) must FAIL with the typed\n *           TEAM_REMOTE_TEAM_ROOT_LIVE_OUTSIDE_TEAM ("already registered") \u2014\n *           the recorded baseline blocker.\n *\n *   Leg B   (fence probe\x2C the C1 premise): the patch layer re-enables the\n *           probe (reject: true\x2C teamSessions=[R1]). Boot 3 (resume): the\n *           boot team root re-adopts on restart and its agent/created must\n *           NOT be vetoed (the fence only targets the configured\n *           Team-managed sessions).\n *\n *           --keep (the Q2 mode): the script ARMS the fence\x2C then HOLDS\n *           (prints its PID) leaving boot 3 alive. The browser (manual step)\n *           then: opens R1 (its own session/follow triggers the veto \u2192\n *           rollback \u2192 api-session/error broadcast) \u2192 observes the error\n *           lane \u2192 clicks \u4ee5 Team \u6a21\u5f0f \u6253\u5f00 (takeover) \u2192 observes whether\n *           the error persists. Finally `kill -TERM <pid>`: the script\n *           collects the probe event log\x2C the mock request log\x2C the p6t6\n *           live state and the session log\x2C writes the Q1 verdict + the Q2\n *           wire evidence\x2C and tears the world down.\n *\n *           Without --keep: the script itself plays the browser over the\n *           wire (WS follow \u2192 veto \u2192 disposed \u2192 api-session/error capture \u2192\n *           disarm \u2192 ensureRootLive success \u2192 surface checks \u2192 Leg C).\n *\n *   Leg C   (ordinary negative control\x2C inside boot 3): a plain DSH session\n *           O1 (not Team-managed) followed/promoted while the fence is ARMED\n *           must pass (no veto) and stay fully usable.\n *\n * Usage:\n *   node spike.mjs           # full scripted run (A + B-wire + C)\x2C teardown\n *   node spike.mjs --keep    # A + B-arm + HOLD for the manual browser Q2 leg\n *\n * Red lines honored: test-use stays pristine (preflight-verified\x2C never\n * touched); DSH_HOME strictly under tests/homes/; host port 3491 family;\n * :3080 and this GUI's home are never touched (pre/post probes recorded);\n * zero core patch.\n */\n\nimport {\n  appendFileSync\x2C existsSync\x2C mkdirSync\x2C openSync\x2C readFileSync\x2C readdirSync\x2C\n  rmSync\x2C writeFileSync\x2C\n} from 'node:fs'\nimport { spawn\x2C spawnSync } from 'node:child_process'\nimport { join\x2C dirname } from 'node:path'\nimport { fileURLToPath\x2C pathToFileURL } from 'node:url'\nimport crypto from 'node:crypto'\nimport http from 'node:http'\nimport { zstdDecompressSync } from 'node:zlib'\n\n// \u2500\u2500 frozen facts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst MAIN_REPO = '/home/user/dsh-plugins/dsh-agent-team'\nconst TESTUSE = join(MAIN_REPO\x2C 'tests'\x2C 'deepseek-harness-test-use')\nconst TESTUSE_PIN = '46a7f68b0922371ce7144b668b90e377d8e799f4'\nconst WORKTREE = join(MAIN_REPO\x2C '.worktrees'\x2C 'team-restart-017rc1')\nconst BRANCH = 'task/team-restart-017rc1'\nconst HOST_BIN = join(TESTUSE\x2C 'apps'\x2C 'cli'\x2C 'lib'\x2C 'bin.js')\nconst MOCK_MODULE = join(WORKTREE\x2C 'packages'\x2C 'tools'\x2C 'harness'\x2C 'mock-deepseek.mjs')\nconst P6T6_PLUGIN = join(WORKTREE\x2C 'packages'\x2C 'tools'\x2C 'harness'\x2C 'plugin.mjs')\nconst P6T6_ROW_NAME = pathToFileURL(P6T6_PLUGIN).href\nconst KIT_DIR = dirname(fileURLToPath(import.meta.url))\n// The probe row's file URL must land under a manifest WITHOUT a dsh.client\n// declaration \u2014 the 0.1.7 client-modules registry attributes any file-URL\n// row to the nearest ancestor package\x2C and the repo-root manifest\n// (dsh-agent-team\x2C dsh.client) would collide with the installed bundle row.\n// packages/tools/harness/ sits under @dsh-agent-team/tools (no dsh.client).\nconst FENCE_PROBE = join(WORKTREE\x2C 'packages'\x2C 'tools'\x2C 'harness'\x2C 'fence-probe.mjs')\nconst EVIDENCE_BASE = join(WORKTREE\x2C 'dev'\x2C 'agent-workflow'\x2C 'evidence'\x2C 'restart-017rc1'\x2C 'phase0')\n// RUN-14 FIX: per-run evidence dirs. The shared-current-dir pattern lost\n// run 9's legA/legB (overwritten by run 10) and run 12's probe JSONL\n// (cleared by run 13's boot \u2014 the JSONL is shared across processes and\n// cleared per boot). Each run now gets phase0/run<stamp>/ exclusively.\nconst RUN_STAMP_EARLY = process.env.RST017_STAMP ?? new Date().toISOString().replace(/[:.]/g\x2C '-').slice(0\x2C 19)\nconst EVIDENCE_DIR = join(EVIDENCE_BASE\x2C `run${RUN_STAMP_EARLY}`)\n\nconst RUN_STAMP = RUN_STAMP_EARLY\n\n// RUN-15 INSTRUMENTATION: event-loop lag watchdog. A setInterval that\n// reports whenever the loop was busy for >1000 ms\x2C with the last\n// activity marker (set by markActivity() at key statements). This\n// localizes run 14's ~30 s receive stall (B2b window: the socket's\n// data events + the 30 s wait timer only resumed together at +30 s).\nglobalThis.__rst017Lag = { last: Date.now()\x2C marker: 'boot'\x2C events: [] }\nfunction markActivity(m) { globalThis.__rst017Lag.marker = `${m} @${Date.now()}` }\nif (process.env.RST017_LAG === '1') {\n  setInterval(() => {\n    const now = Date.now()\n    const lag = now - globalThis.__rst017Lag.last\n    globalThis.__rst017Lag.last = now\n    if (lag > 1000) {\n      const e = { at: new Date().toISOString()\x2C lagMs: lag\x2C lastActivity: globalThis.__rst017Lag.marker }\n      globalThis.__rst017Lag.events.push(e)\n      console.log(`[lag] EVENT-LOOP BLOCKED ${lag}ms; lastActivity=${globalThis.__rst017Lag.marker}`)\n    }\n  }\x2C 200)\n}\nconst KEEP_MODE = process.argv.includes('--keep')\n\nconst HOME = process.env.RST017_WORLD ?? join(MAIN_REPO\x2C 'tests'\x2C 'homes'\x2C `rst017-spike-${RUN_STAMP}`)\nconst WORKSPACE = join(HOME\x2C 'workspace')\nconst XDG = join(HOME\x2C '.xdg')\nconst REPO_GIT = join(HOME\x2C 'repo.git')\nconst PROFILE_DIR = join(HOME\x2C 'profiles'\x2C 'web')\nconst BLUEPRINT_DIR = join(HOME\x2C 'blueprints')\nconst SPILL_ROOT = join(HOME\x2C 'spill')\n\n// 3492/3497 (3491 family): run 5's kit crash orphaned a boot host that still\n// listens on 3491 (pid recorded in the run-5 evidence; workspace-only policy\n// forbids killing it\x2C so this kit simply moves one family member over).\nconst HOST_PORT = Number(process.env.RST017_HOST_PORT ?? 3492)\nconst MOCK_PORT = Number(process.env.RST017_MOCK_PORT ?? 3497)\n\nconst BOOT_ROOT = `session-rst017-boot-${RUN_STAMP}`\nconst DYN_ROOT = `session-rst017-dyn-${RUN_STAMP}`\nconst ORD_SESSION = `session-rst017-ord-${RUN_STAMP}`\nconst BP_ANCHOR_ID = 'team.rst017-anchor'\nconst BP_MAIN_ID = 'team.rst017-main'\nconst MODEL_ID = `rst017-model-${RUN_STAMP}`\nconst PRESET_ID = 'standard'\nconst P_BOOT = `RST017BOOT_PERSONA_${RUN_STAMP}`\nconst P_DYN = `RST017DYN_PERSONA_${RUN_STAMP}`\nconst MK_DONE = `RST017DONE_${RUN_STAMP}`\nconst MK_ORD = `RST017ORD_${RUN_STAMP}`\n\nconst BOOT_MARKER = /dsh web: http:\\/\\/127\\.0\\.0\\.1:(\\d+)\\/\\?token=[A-Za-z0-9_-]+/\nconst PROBE_TEAM_FILE = join(WORKSPACE\x2C 'team'\x2C 'test.md')\nconst PROBE_TEAM_CONTENT = `rst017-team-probe-${RUN_STAMP}`\n\n// \u2500\u2500 small state \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlet fatal = null\nconst results = []\nfunction log(msg) { console.log(`[rst017-spike ${RUN_STAMP}] ${msg}`) }\nfunction die(msg) { fatal = msg; log(`FATAL: ${msg}`) }\nfunction check(leg\x2C name\x2C ok\x2C detail = '') {\n  results.push({ leg\x2C name\x2C ok: !!ok\x2C detail })\n  log(`${ok ? 'PASS' : 'FAIL'} [${leg}] ${name}${detail ? ` \u2014 ${detail}` : ''}`)\n  return !!ok\n}\nfunction legDir(leg) {\n  const d = join(EVIDENCE_DIR\x2C leg)\n  mkdirSync(d\x2C { recursive: true })\n  return d\n}\nfunction writeEvidence(leg\x2C name\x2C content) {\n  const d = legDir(leg)\n  const p = join(d\x2C name)\n  writeFileSync(p\x2C typeof content === 'string' ? content : JSON.stringify(content\x2C null\x2C 2))\n  return p\n}\nconst sleep = (ms) => new Promise((r) => setTimeout(r\x2C ms))\n\n// \u2500\u2500 tiny http helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nasync function fetchJson(url\x2C init\x2C timeoutMs = 60_000) {\n  const res = await fetch(url\x2C { ...init\x2C signal: AbortSignal.timeout(timeoutMs) }).catch((e) => ({ status: 0\x2C body: null\x2C error: e.message }))\n  const body = res.status === 0 ? null : await res.json().catch(() => null)\n  return { status: res.status\x2C body }\n}\nasync function probePort(port) {\n  try {\n    const res = await fetch(`http://127.0.0.1:${port}/`\x2C { signal: AbortSignal.timeout(5_000) })\n    return { port\x2C reachable: true\x2C status: res.status }\n  } catch {\n    return { port\x2C reachable: false\x2C status: null }\n  }\n}\nasync function portFree(port\x2C timeoutMs = 3_000) {\n  try {\n    await fetch(`http://127.0.0.1:${port}/`\x2C { signal: AbortSignal.timeout(timeoutMs) })\n    return false\n  } catch {\n    return true\n  }\n}\nasync function waitForPortFree(port\x2C timeoutMs = 30_000) {\n  const deadline = Date.now() + timeoutMs\n  for (;;) {\n    if (await portFree(port\x2C 500)) return true\n    if (Date.now() >= deadline) return false\n    await sleep(300)\n  }\n}\nasync function authenticate(origin\x2C token) {\n  const res = await fetch(`${origin}/?token=${token}`\x2C { redirect: 'manual'\x2C signal: AbortSignal.timeout(30_000) })\n  const setCookie = res.headers.get('set-cookie')\n  if (setCookie !== null) return setCookie.split(';'\x2C 1)[0]\n  if (res.status >= 200 && res.status < 300) return null\n  throw new Error(`dsh web authentication returned HTTP ${res.status} with no set-cookie`)\n}\nfunction rpcBody(method\x2C params\x2C version\x2C tag) {\n  return JSON.stringify({\n    type: 'client-request'\x2C\n    rpcId: `${tag}-${Math.random().toString(36).slice(2\x2C 12)}`\x2C\n    method\x2C\n    payload: { version\x2C params }\x2C\n  })\n}\nasync function remoteCall(origin\x2C cookie\x2C method\x2C params\x2C tag = 'rst'\x2C version = 1\x2C timeoutMs = 240_000) {\n  return fetchJson(`${origin}/team-remote/${method}`\x2C {\n    method: 'POST'\x2C\n    headers: { 'content-type': 'application/json'\x2C ...(cookie ? { cookie } : {}) }\x2C\n    body: rpcBody(method\x2C params\x2C version\x2C tag)\x2C\n  }\x2C timeoutMs)\n}\n/**\n * The 0.1.7 session channel wire shape (the dsh-client-connection RPC\n * channel mounted at /api/session/*; the U8-proven envelope: the args ride\n * `{ args: { request } }`\x2C no contract version stamp).\n */\n/**\n * The 0.1.7 session prompt wire shape (U8-proven; the prompt is queued\n * asynchronously \u2014 the model request arrives on the mock\x2C not in the reply).\n */\nasync function apiPrompt(origin\x2C cookie\x2C sessionId\x2C text\x2C tag = 'rst') {\n  const requestId = `${tag}-${Math.random().toString(36).slice(2\x2C 12)}`\n  return fetchJson(`${origin}/api/session/prompt`\x2C {\n    method: 'POST'\x2C\n    headers: { 'content-type': 'application/json'\x2C ...(cookie ? { cookie } : {}) }\x2C\n    body: JSON.stringify({\n      type: 'client-request'\x2C\n      rpcId: requestId\x2C\n      method: 'session/prompt'\x2C\n      payload: { args: { request: { requestId\x2C sessionId\x2C mode: 'queue'\x2C content: [{ type: 'text'\x2C text }] } } }\x2C\n    })\x2C\n  }\x2C 300_000)\n}\nasync function apiCreateSession(origin\x2C cookie\x2C sessionId\x2C cwd) {\n  return fetchJson(`${origin}/api/session/create`\x2C {\n    method: 'POST'\x2C\n    headers: { 'content-type': 'application/json'\x2C ...(cookie ? { cookie } : {}) }\x2C\n    body: JSON.stringify({\n      type: 'client-request'\x2C\n      rpcId: `rst-create-session-${Math.random().toString(36).slice(2\x2C 12)}`\x2C\n      method: 'session/create'\x2C\n      payload: { args: { request: { sessionId\x2C cwd } } }\x2C\n    })\x2C\n  }\x2C 60_000)\n}\n\n// \u2500\u2500 raw WebSocket client (RFC 6455\x2C cookie-carrying upgrade\x2C no deps) \u2500\u2500\u2500\u2500\u2500\u2500\n/**\n * Minimal client: HTTP/1.1 upgrade with custom headers\x2C masked client text\n * frames\x2C unmasked server text frames (fragmentation-safe)\x2C ping\u2192pong\x2C\n * close. Enough for the /api/remote.mux stream protocol.\n */\n/** RST017_WS_TRACE=1 sink: one entry per closed/failed socket. */\nconst wsTraceSink = []\nclass RemoteMuxSocket {\n  constructor(url\x2C { cookie\x2C timeoutMs = 20_000 } = {}) {\n    const u = new URL(url)\n    this.host = u.hostname\n    this.port = u.port ? Number(u.port) : 80\n    this.path = u.pathname + u.search\n    this.cookie = cookie\n    this.timeoutMs = timeoutMs\n    this.socket = null\n    this.buffer = Buffer.alloc(0)\n    this.fragPayload = null\n    this.frames = []\n    this.waiters = []\n    this.closed = false\n    this.closeError = null\n    // RST017_WS_TRACE=1: record EVERY frame (both directions\x2C incl. control\n    // frames) to diagnose host-side socket closes (run 8: "ws closed by\n    // host" with no close frame during session/follow streaming).\n    this.trace = process.env.RST017_WS_TRACE === '1' ? [] : null\n    this.traceT0 = Date.now()\n    this.label = 'unlabeled'\n    this._open = new Promise((res\x2C rej) => { this._openRes = res; this._openRej = rej })\n  }\n\n  _trace(dir\x2C opcode\x2C payload) {\n    if (this.trace === null) return\n    const head = payload.subarray(0\x2C 400)\n    this.trace.push({\n      t: Date.now() - this.traceT0\x2C dir\x2C op: opcode\x2C len: payload.length\x2C\n      head: head.toString('utf8').slice(0\x2C 400)\x2C\n    })\n  }\n  _flushTrace() {\n    if (this.trace === null) return\n    const frames = this.trace\n    this.trace = null\n    wsTraceSink.push({\n      label: this.label\x2C\n      closeError: this.closeError !== null ? String(this.closeError?.message ?? this.closeError) : null\x2C\n      frames\x2C\n    })\n  }\n\n  connect() {\n    const req = http.request({\n      host: this.host\x2C\n      port: this.port\x2C\n      path: this.path\x2C\n      method: 'GET'\x2C\n      headers: {\n        connection: 'Upgrade'\x2C\n        upgrade: 'websocket'\x2C\n        'sec-websocket-key': crypto.randomBytes(16).toString('base64')\x2C\n        'sec-websocket-version': '13'\x2C\n        ...(this.cookie ? { cookie: this.cookie } : {})\x2C\n      }\x2C\n    })\n    // Node fires the request 'upgrade' event (NOT the response callback) for\n    // a 101 Switching Protocols; `head` may already hold frame bytes.\n    req.on('upgrade'\x2C (res\x2C socket\x2C head) => {\n      if (res.statusCode !== 101) {\n        socket.destroy()\n        this._fail(new Error(`ws upgrade rejected: HTTP ${res.statusCode}`))\n        return\n      }\n      this.socket = socket\n      if (head && head.length > 0) this.buffer = Buffer.from(head)\n      this._attach()\n      this._openRes()\n      if (this.buffer.length > 0) this._pump()\n    })\n    req.on('response'\x2C (res) => {\n      // Non-upgrade response (e.g. 401/404): the connection is plain HTTP.\n      const status = res.statusCode\n      res.resume()\n      this._fail(new Error(`ws upgrade rejected: HTTP ${status}`))\n    })\n    // Upgrade-phase timeout only (a manual timer \u2014 a socket timeout would\n    // later kill the long-lived stream connection).\n    const upgradeTimer = setTimeout(() => this._fail(new Error('ws upgrade timeout'))\x2C this.timeoutMs)\n    const clearUpgradeTimer = () => clearTimeout(upgradeTimer)\n    req.on('error'\x2C (e) => { clearUpgradeTimer(); this._fail(e) })\n    req.on('upgrade'\x2C () => clearUpgradeTimer())\n    req.on('response'\x2C () => clearUpgradeTimer())\n    req.end()\n    return this._open\n  }\n\n  _fail(err) {\n    if (this.closed) return\n    this.closed = true\n    this.closeError = err\n    this._openRej?.(err)\n    for (const w of this.waiters) w.rej(err)\n    this.waiters = []\n    this._flushTrace()\n    try { this.socket?.destroy() } catch { /* already gone */ }\n  }\n\n  _attach() {\n    const sock = this.socket\n    sock.on('data'\x2C (chunk) => {\n      if (process.env.RST017_RAW_LOG === '1') {\n        const b0 = chunk.length > 0 ? chunk[0].toString(16).padStart(2\x2C '0') : '?'\n        const b1 = chunk.length > 1 ? chunk[1].toString(16).padStart(2\x2C '0') : '?'\n        const op = chunk.length > 1 ? (chunk[1] & 0x0f) : -1\n        const note = op === 9 ? ' <== PING' : op === 10 ? ' <== PONG?' : op === 8 ? ' <== CLOSE-FRAME!' : ''\n        console.log(`[rawlog ${this.label} +${Date.now() - (this.__t0 ?? (this.__t0 = Date.now()))}ms] RAW ${chunk.length}B b0=0x${b0} b1=0x${b1}${note}`)\n      }\n      this.buffer = Buffer.concat([this.buffer\x2C chunk])\n      this._pump()\n    })\n    sock.on('close'\x2C () => {\n      if (!this.closed) {\n        this.closed = true\n        this.closeError = new Error('ws closed by host')\n        for (const w of this.waiters) w.rej(this.closeError)\n        this.waiters = []\n      }\n      this._flushTrace()\n    })\n    sock.on('error'\x2C (e) => this._fail(e))\n  }\n\n  _pump() {\n    for (;;) {\n      const first = this.fragPayload === null ? 2 : 1\n      if (this.buffer.length < first) return\n      const fin = (this.buffer[0] & 0x80) !== 0\n      const opcode = this.buffer[0] & 0x0f\n      const b1 = this.fragPayload === null ? this.buffer[1] : this.buffer[0]\n      const masked = (b1 & 0x80) !== 0\n      let payloadLen = b1 & 0x7f\n      let offset = this.fragPayload === null ? 2 : 1\n      if (payloadLen === 126) {\n        const need = this.fragPayload === null ? 4 : 3\n        if (this.buffer.length < need) return\n        payloadLen = this.buffer.readUInt16BE(need - 2)\n        offset = need\n      } else if (payloadLen === 127) {\n        const need = this.fragPayload === null ? 10 : 9\n        if (this.buffer.length < need) return\n        // RUN-14 FIX: the 64-bit length field follows the 2-byte header at\n        // bytes 2..9 (new frame) / 1..8 (continuation) \u2014 NOT at `need - 2`\n        // (that offset is only correct for the 16-bit case). The old code\n        // read payload bytes as the length (~exabyte) on every frame\n        // >= 65536 B\x2C desyncing the parser: the follow snapshot was never\n        // delivered\x2C PINGs were swallowed into the buffer\x2C no PONG was\n        // sent\x2C and the 0.1.7 mux heartbeat (2 s \xd7 2 misses) terminated\n        // the socket framelessly at ~+6 s. This was the A4/B2 "ws closed\n        // by host" mechanism for ALL runs with a large snapshot.\n        payloadLen = Number(this.buffer.readBigUInt64BE(this.fragPayload === null ? 2 : 1))\n        offset = need\n      }\n      if (masked) {\n        if (this.buffer.length < offset + 4 + payloadLen) return\n        const mask = this.buffer.subarray(offset\x2C offset + 4)\n        offset += 4\n        const payload = Buffer.from(this.buffer.subarray(offset\x2C offset + payloadLen))\n        this.buffer = this.buffer.subarray(offset + payloadLen)\n        for (let i = 0; i < payload.length; i += 1) payload[i] ^= mask[i % 4]\n        this._safeFrame(opcode\x2C fin\x2C payload)\n      } else {\n        if (this.buffer.length < offset + payloadLen) return\n        const payload = Buffer.from(this.buffer.subarray(offset\x2C offset + payloadLen))\n        this.buffer = this.buffer.subarray(offset + payloadLen)\n        this._safeFrame(opcode\x2C fin\x2C payload)\n      }\n    }\n  }\n\n  /** Frame handler wrapper: frame-processing errors must never escape the\n   *  socket 'data' handler (they would kill the kit with an uncaught throw\n   *  \u2014 the run-5 crash mode). Fail the socket instead. */\n  _safeFrame(opcode\x2C fin\x2C payload) {\n    try { this._framePayload(opcode\x2C fin\x2C payload) }\n    catch (e) { this._fail(new Error(`ws frame handling error: ${String(e?.message ?? e)}`)) }\n  }\n\n  _framePayload(opcode\x2C fin\x2C payload) {\n    this._trace('rx'\x2C opcode\x2C payload)\n    if (opcode === 0x8) {\n      // Host-initiated close: record the code/reason for the evidence.\n      if (this.closeError === null && payload.length >= 2) {\n        const code = payload.readUInt16BE(0)\n        const reason = payload.subarray(2).toString('utf8')\n        this.closeError = new Error(`ws closed by host (code=${code}${reason ? `: ${reason}` : ''})`)\n      }\n      this.close()\n      return\n    }\n    if (opcode === 0x9) { this._rawFrame(0xA\x2C payload); return }\n    if (opcode === 0xA) return\n    if (opcode !== 0x1) { this._fail(new Error(`ws unexpected opcode ${opcode}`)); return }\n    if (this.fragPayload === null) this.fragPayload = []\n    this.fragPayload.push(payload)\n    if (fin) {\n      const text = Buffer.concat(this.fragPayload).toString('utf8')\n      this.fragPayload = null\n      let msg\n      try { msg = JSON.parse(text) } catch { return }\n      const w = this.waiters.shift()\n      if (w !== undefined) w.res(msg)\n      else this.frames.push(msg)\n    }\n  }\n\n  _rawFrame(opcode\x2C payload) {\n    if (this.socket === null || this.socket.destroyed) return\n    this._trace('tx'\x2C opcode\x2C payload)\n    const len = payload.length\n    // Client\u2192server frames MUST be masked (RFC 6455 \xa75.3): the mask bit is\n    // the high bit of the SECOND header byte. Runs 5/6 omitted it \u2014 the\n    // smoke-test's lenient fake gateway accepted the unmasked frames\x2C but\n    // the real ws@8 receiver closed the socket with 1002 (it read the\n    // appended 4 "mask" bytes as payload \u2192 invalid UTF-8).\n    let header\n    if (len < 126) header = Buffer.from([0x80 | opcode\x2C 0x80 | len])\n    else if (len < 65536) {\n      header = Buffer.alloc(4)\n      header[0] = 0x80 | opcode\n      header[1] = 0x80 | 126\n      header.writeUInt16BE(len\x2C 2)\n    } else {\n      header = Buffer.alloc(10)\n      header[0] = 0x80 | opcode\n      header[1] = 0x80 | 127\n      header.writeBigUInt64BE(BigInt(len)\x2C 2)\n    }\n    const mask = crypto.randomBytes(4)\n    const masked = Buffer.from(payload)\n    for (let i = 0; i < masked.length; i += 1) masked[i] ^= mask[i % 4]\n    this.socket.write(Buffer.concat([header\x2C mask\x2C masked]))\n  }\n\n  send(text) {\n    this._rawFrame(0x1\x2C Buffer.from(text\x2C 'utf8'))\n  }\n\n  /** Next complete message\x2C or reject on close/failure/timeout. */\n  next(timeoutMs = 30_000) {\n    if (this.frames.length > 0) return Promise.resolve(this.frames.shift())\n    if (this.closed) return Promise.reject(this.closeError ?? new Error('ws closed'))\n    return new Promise((res\x2C rej) => {\n      const timer = setTimeout(() => {\n        this.waiters = this.waiters.filter((w) => w !== wRef)\n        rej(new Error('ws next-frame timeout'))\n      }\x2C timeoutMs)\n      const wRef = {\n        res: (m) => { clearTimeout(timer); res(m) }\x2C\n        rej: (e) => { clearTimeout(timer); rej(e) }\x2C\n      }\n      this.waiters.push(wRef)\n    })\n  }\n\n  close() {\n    if (this.closed) return\n    this.closed = true\n    for (const w of this.waiters) w.rej(this.closeError ?? new Error('ws closed by client'))\n    this.waiters = []\n    try { this._rawFrame(0x8\x2C Buffer.from([0x3e\x2C 0x00])) } catch { /* best effort */ }\n    const t = setTimeout(() => { try { this.socket?.destroy() } catch { /* gone */ } }\x2C 300)\n    t.unref?.()\n  }\n}\n\n// \u2500\u2500 the scripted mock model \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nasync function startMockModel() {\n  const { startMockModel: startMock } = await import(pathToFileURL(MOCK_MODULE).href)\n  const decide = ({ req }) => {\n    const body = req\n    const msgs = body?.messages ?? []\n    const userTexts = msgs.filter((m) => m?.role === 'user')\n      .map((m) => (typeof m.content === 'string' ? m.content\n        : Array.isArray(m.content) ? m.content.filter((b) => b?.type === 'text').map((b) => b.text ?? '').join('')\n        : ''))\n      .filter((t) => t.length > 0)\n    const userText = userTexts.join('\\n')\n    if (userText.includes(MK_ORD)) return { kind: 'text'\x2C content: `RST017_ORD_ACK ${MK_ORD}` }\n    if (userText.includes(MK_DONE)) return { kind: 'text'\x2C content: `RST017_DONE ${MK_DONE}` }\n    return { kind: 'text'\x2C content: 'rst017 spike ack' }\n  }\n  return startMock({ port: MOCK_PORT\x2C decide\x2C log: () => {} })\n}\n\n// \u2500\u2500 host lifecycle \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction spawnHost({ port\x2C logPath\x2C detached = false }) {\n  const outFd = openSync(logPath\x2C 'a')\n  const alive = { exited: false }\n  const child = spawn(\n    process.execPath\x2C\n    [HOST_BIN\x2C 'web'\x2C '--port'\x2C String(port)\x2C '--no-open']\x2C\n    {\n      cwd: WORKSPACE\x2C\n      stdio: ['ignore'\x2C outFd\x2C outFd]\x2C\n      env: {\n        ...process.env\x2C\n        DSH_HOME: HOME\x2C\n        DSH_CLIENT_COMMIT_HASH: TESTUSE_PIN.slice(0\x2C 10)\x2C\n        DEEPSEEK_BASE_URL: `http://127.0.0.1:${MOCK_PORT}`\x2C\n        DEEPSEEK_API_KEY: 'rst017-spike-mock-key'\x2C\n        // RST017_HOST_HOOK=1: load the zero-modification runtime\n        // observation hook into the host (logs to the host's stderr \u2192 the\n        // per-boot instance log). Used to capture the host-side teardown\n        // when the spike's follow socket gets closed (run 10/11).\n        // NOTE: the hook lives in the MAIN repo phase0 dir (KIT_DIR) \u2014 the\n        // worktree copy (EVIDENCE_DIR) holds evidence\x2C not kit sources.\n        ...(process.env.RST017_HOST_HOOK === '1' ? { NODE_OPTIONS: `--import ${join(KIT_DIR\x2C 'diag-hook.mjs')}` } : {})\x2C\n      }\x2C\n      ...(detached ? { detached: true } : {})\x2C\n    }\x2C\n  )\n  child.on('close'\x2C () => { alive.exited = true })\n  child.on('error'\x2C () => { alive.exited = true })\n  if (detached) child.unref?.()\n  return { child\x2C alive: () => !alive.exited }\n}\nfunction stopHost(child) {\n  try { child.kill('SIGTERM') } catch { /* already gone */ }\n}\nasync function waitForLogLine(logPath\x2C regex\x2C timeoutMs\x2C alive) {\n  const deadline = Date.now() + timeoutMs\n  let last = -1\n  for (;;) {\n    try {\n      const text = readFileSync(logPath\x2C 'utf8')\n      if (text.length > last) {\n        const m = regex.exec(text.slice(last))\n        if (m !== null) return m[0]\n        last = text.length\n      }\n    } catch { /* not created yet */ }\n    if (!alive()) break\n    if (Date.now() >= deadline) break\n    await sleep(250)\n  }\n  return null\n}\nfunction logTail(logPath\x2C n = 40) {\n  try {\n    const lines = readFileSync(logPath\x2C 'utf8').split('\\n').filter((l) => l.length > 0)\n    return lines.slice(-n).join('\\n')\n  } catch {\n    return '(no log)'\n  }\n}\n\n// \u2500\u2500 blueprints (plain legacy \u2014 NO capabilities: the spike keeps the surface\n//     at the stock preset + full team catalog\x2C no strict-gate involvement) \u2500\u2500\nconst BP_ANCHOR_YAML = [\n  '---'\x2C\n  'schemaVersion: 1'\x2C\n  `blueprintId: ${BP_ANCHOR_ID}`\x2C\n  'revision: "1"'\x2C\n  'leader:'\x2C\n  '  templateId: leader'\x2C\n  `  persona: "You are the leader of the rst017 boot team. ${P_BOOT} Answer concisely and stop."`\x2C\n  'members:'\x2C\n  '  - templateId: worker'\x2C\n  `    persona: "You are a worker of the rst017 boot team. ${P_BOOT}"`\x2C\n  'memberEnvelopes: []'\x2C\n  'requirements: []'\x2C\n  'policyStates: []'\x2C\n  'metadata: {}'\x2C\n  '---'\x2C\n  ''\x2C\n].join('\\n')\n\nfunction mainBlueprintYaml() {\n  return [\n    '---'\x2C\n    'schemaVersion: 1'\x2C\n    `blueprintId: ${BP_MAIN_ID}`\x2C\n    'revision: "1"'\x2C\n    'leader:'\x2C\n    '  templateId: leader'\x2C\n    `  persona: ${JSON.stringify(`You are the leader of the rst017 dynamic spike team. ${P_DYN} Answer concisely and stop.`)}`\x2C\n    'members:'\x2C\n    '  - templateId: worker'\x2C\n    '    displayName: "Worker"'\x2C\n    `    persona: ${JSON.stringify(`You are a worker of the rst017 dynamic spike team. ${P_DYN}`)}`\x2C\n    'teamEnvelope:'\x2C\n    '  allow:'\x2C\n    '    - assign-task'\x2C\n    '    - create-member'\x2C\n    '    - send-message'\x2C\n    '    - report-progress'\x2C\n    '    - archive-member'\x2C\n    '  deny: []'\x2C\n    'memberEnvelopes:'\x2C\n    '  - templateId: worker'\x2C\n    '    envelope:'\x2C\n    '      allow:'\x2C\n    '        - send-message'\x2C\n    '        - report-progress'\x2C\n    '      deny: []'\x2C\n    'policyStates: []'\x2C\n    'metadata: {}'\x2C\n    '---'\x2C\n    ''\x2C\n  ].join('\\n')\n}\n\nfunction teamRowConfig(phase) {\n  return {\n    bootPhase: phase\x2C\n    rootSessionId: BOOT_ROOT\x2C\n    blueprintSource: BP_ANCHOR_YAML\x2C\n    blueprintDir: BLUEPRINT_DIR\x2C\n    rootPresetId: PRESET_ID\x2C\n    memberPresetId: PRESET_ID\x2C\n    seedMembers: []\x2C\n    generation: 1\x2C\n    staticModel: { provider: 'deepseek-official'\x2C model: MODEL_ID }\x2C\n    deniedSelection: null\x2C\n    mcpServers: []\x2C\n    environmentFacts: [\n      { domain: 'tool'\x2C subject: 'web'\x2C available: true\x2C generation: 1 }\x2C\n      { domain: 'skill'\x2C subject: 'base'\x2C available: true\x2C generation: 1 }\x2C\n      { domain: 'persona'\x2C subject: 'standard'\x2C available: true\x2C generation: 1 }\x2C\n    ]\x2C\n    externalPolicyFacts: { hard: {}\x2C capabilityExists: {} }\x2C\n  }\n}\n\n// \u2500\u2500 yaml emission (rc2 kit shape) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction yamlScalar(v) {\n  if (v === null) return 'null'\n  if (typeof v === 'string') return JSON.stringify(v)\n  return String(v)\n}\nfunction yamlEmit(key\x2C value\x2C indent) {\n  const pad = '  '.repeat(indent)\n  if (value !== null && typeof value === 'object') {\n    const empty = Array.isArray(value) ? value.length === 0 : Object.keys(value).length === 0\n    if (empty) return [`${pad}${key}: ${Array.isArray(value) ? '[]' : '{}'}`]\n    if (Array.isArray(value)) {\n      return [`${pad}${key}:`\x2C ...value.flatMap((item) => yamlEmitItem(item\x2C indent + 1))]\n    }\n    return [`${pad}${key}:`\x2C ...Object.entries(value).flatMap(([k\x2C v]) => yamlEmit(k\x2C v\x2C indent + 1))]\n  }\n  return [`${pad}${key}: ${yamlScalar(value)}`]\n}\nfunction yamlEmitItem(item\x2C indent) {\n  const pad = '  '.repeat(indent)\n  // Scalar sequence elements (e.g. a string in a string array) must emit as\n  // `- "value"` \u2014 Object.entries() on a string yields 0..n character rows\x2C\n  // which the patch-layer YAML parser reads back as a mapping (run 8:\n  // teamSessions came back as {0:"s"\x2C1:"e"\x2C...} \u2192 the probe's\n  // Array.isArray guard saw an empty set \u2192 the veto never fired).\n  if (item === null || typeof item !== 'object') return [`${pad}- ${yamlScalar(item)}`]\n  const entries = Object.entries(item)\n  const [firstKey\x2C firstValue] = entries[0]\n  const firstLines = yamlEmit(firstKey\x2C firstValue\x2C indent + 1)\n  const rest = entries.slice(1).flatMap(([k\x2C v]) => yamlEmit(k\x2C v\x2C indent + 1))\n  return [`${pad}- ${firstLines[0].slice((indent + 1) * 2)}`\x2C ...firstLines.slice(1)\x2C ...rest]\n}\n\n/**\n * The profile patch layer. `probeReject` flips the fence-probe row between\n * the passive (Leg A) and the active-veto (Leg B) modes \u2014 same row module\x2C\n * only the row config changes.\n */\nfunction writePatchFile(phase\x2C probeReject\x2C autoArm = false) {\n  mkdirSync(PROFILE_DIR\x2C { recursive: true })\n  const lines = [\n    `# rst017 Phase 0 spike patch layer (run ${RUN_STAMP}\x2C bootPhase ${phase}\x2C probeReject ${probeReject}\x2C autoArm ${autoArm})`\x2C\n    '- insert:'\x2C\n    ...yamlEmitItem({ id: 'dsh-agent-team'\x2C name: 'dsh-agent-team/host'\x2C config: teamRowConfig(phase) }\x2C 2)\x2C\n    ...yamlEmitItem({ id: 'p6t6-team-tools'\x2C name: P6T6_ROW_NAME }\x2C 2)\x2C\n    ...yamlEmitItem({\n      id: 'team-restart-fence-probe'\x2C\n      name: pathToFileURL(FENCE_PROBE).href\x2C\n      config: { reject: probeReject\x2C autoArm\x2C teamSessions: [DYN_ROOT]\x2C reportDir: join(EVIDENCE_DIR\x2C 'probe-events') }\x2C\n    }\x2C 2)\x2C\n    ...yamlEmitItem({ id: 'team-spill-local'\x2C name: 'dsh-agent-team/spill-local'\x2C config: { root: SPILL_ROOT } }\x2C 2)\x2C\n    ''\x2C\n  ]\n  writeFileSync(join(PROFILE_DIR\x2C 'cordis.patch.yml')\x2C lines.join('\\n'))\n}\n\nfunction writeDirective(boot\x2C phase) {\n  writeFileSync(join(HOME\x2C 'p6t6-directive.json')\x2C JSON.stringify({\n    boot\x2C\n    phase\x2C\n    reportDir: EVIDENCE_DIR\x2C\n    runStamp: RUN_STAMP\x2C\n    rootSessionId: BOOT_ROOT\x2C\n  }\x2C null\x2C 2))\n}\n\n// \u2500\u2500 the $events + session/follow stream carrier \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nasync function openMux(origin\x2C cookie\x2C label = 'mux') {\n  const wsUrl = origin.replace(/^http/\x2C 'ws') + '/api/remote.mux'\n  const ws = new RemoteMuxSocket(wsUrl\x2C { cookie })\n  ws.label = label\n  await ws.connect()\n  return ws\n}\n/** Flush the RST017_WS_TRACE sink into evidence (no-op unless tracing). */\nfunction dumpWsTraces(tag) {\n  if (wsTraceSink.length === 0) return\n  writeEvidence(tag\x2C 'ws-traces.json'\x2C wsTraceSink.splice(0))\n}\nasync function openEventsStream(ws) {\n  const streamId = 'ev-' + Math.random().toString(36).slice(2\x2C 10)\n  ws.send(JSON.stringify({ type: 'open'\x2C streamId\x2C endpoint: '$events'\x2C payload: { args: {} } }))\n  const ready = await ws.next(30_000)\n  if (ready?.streamId !== streamId || ready.type !== 'item' || ready.value?.type !== 'ready') {\n    throw new Error(`unexpected first $events frame: ${JSON.stringify(ready).slice(0\x2C 300)}`)\n  }\n  return streamId\n}\n/**\n * Open a `session/follow` stream and collect frames until the first snapshot\n * arrives (the follow handler yields the snapshot FIRST\x2C then promotes in\n * the background \u2014 so the snapshot is the "the browser got in" signal).\n */\nasync function followSession(ws\x2C sessionId\x2C { timeoutMs = 45_000 } = {}) {\n  const streamId = 'fol-' + Math.random().toString(36).slice(2\x2C 10)\n  // 0.1.7 typert descriptor: args = { request: <SessionFollowRequest> } \u2014\n  // the request object itself carries `address` (types.ts:485); run 7's\n  // gateway/arguments-invalid ("missing request; unexpected address")\n  // pinned the wrapping.\n  ws.send(JSON.stringify({\n    type: 'open'\x2C\n    streamId\x2C\n    endpoint: 'session/follow'\x2C\n    payload: { args: { request: { address: { kind: 'session'\x2C sessionId } } } }\x2C\n  }))\n  const deadline = Date.now() + timeoutMs\n  for (;;) {\n    const frame = await ws.next(deadline - Date.now())\n    if (frame?.streamId !== streamId) continue\n    if (frame.type === 'error') throw new Error(`session/follow stream error: ${JSON.stringify(frame.error)}`)\n    if (frame.type === 'item' && frame.value?.type === 'snapshot') {\n      return { streamId\x2C snapshot: frame.value }\n    }\n    if (Date.now() >= deadline) throw new Error('session/follow: no snapshot frame in time')\n  }\n}\n/**\n * RUN-10 helper: wait for a $events `emit` frame on the given stream whose\n * value matches `predicate`\x2C skipping frames of other streams (they are\n * re-queued). Returns the matching frame or null on close/timeout.\n */\nasync function waitForEventFrame(ws\x2C streamId\x2C predicate\x2C timeoutMs = 30_000) {\n  const deadline = Date.now() + timeoutMs\n  const isTarget = (f) => f?.streamId === streamId && f.type === 'item' && f.value?.type === 'emit' && predicate(f.value)\n  for (;;) {\n    // Drain the local queue first (snapshot-window frames may already be parked).\n    let found = null\n    const rest = []\n    while (ws.frames.length > 0) {\n      const f = ws.frames.shift()\n      if (found === null && isTarget(f)) found = f\n      else rest.push(f)\n    }\n    if (found !== null) return found\n    for (const f of rest) ws.frames.unshift(f)\n    if (ws.closed) return null\n    if (Date.now() >= deadline) return null\n    try {\n      const f = await ws.next(deadline - Date.now())\n      if (f === undefined) return null\n      if (isTarget(f)) return f\n      ws.frames.unshift(f)\n    } catch { return null }\n  }\n}\nasync function fenceHealth(origin) {\n  return fetchJson(`${origin}/__fence/health`\x2C undefined\x2C 30_000)\n}\nasync function fenceEvents(origin) {\n  const res = await fetchJson(`${origin}/__fence/events`\x2C undefined\x2C 30_000)\n  return res.body?.events ?? []\n}\nasync function fenceArmed(origin\x2C armed) {\n  return fetchJson(`${origin}/__fence/armed`\x2C {\n    method: 'POST'\x2C\n    headers: { 'content-type': 'application/json' }\x2C\n    body: JSON.stringify({ armed })\x2C\n  }\x2C 30_000)\n}\nasync function fencePermit(origin\x2C sessionId) {\n  return fetchJson(`${origin}/__fence/permit`\x2C {\n    method: 'POST'\x2C\n    headers: { 'content-type': 'application/json' }\x2C\n    body: JSON.stringify({ sessionId })\x2C\n  }\x2C 30_000)\n}\n\n// \u2500\u2500 session log inspection (read-only; the 0.1.7 layout is\n//     <home>/sessions/<profile>/<sessionId>/session[.vN].jsonl[.zstd]) \u2500\u2500\u2500\u2500\u2500\u2500\nfunction findSessionLogs(home\x2C sessionId) {\n  const sessionsRoot = join(home\x2C 'sessions')\n  const out = []\n  let profiles = []\n  try { profiles = readdirSync(sessionsRoot\x2C { withFileTypes: true }).filter((e) => e.isDirectory()) } catch { return out }\n  for (const p of profiles) {\n    const dir = join(sessionsRoot\x2C p.name\x2C sessionId)\n    let entries = []\n    try { entries = readdirSync(dir\x2C { withFileTypes: true }) } catch { continue }\n    for (const e of entries) {\n      if (e.isFile() && /^session(\\.v\\d+)?\\.jsonl(\\.zstd)?$/.test(e.name)) out.push(join(dir\x2C e.name))\n    }\n  }\n  return out\n}\n/**\n * Structural scan of a concatenated-Zstandard session log (ported from\n * upstream `dsh-session-persistence-jsonl/src/zstd.ts scanZstdFrames`\x2C\n * read-only reference \u2014 the 0.1.7 generation file is a SEQUENCE of\n * independent zstd frames: frame 1 = the session header line\x2C one more\n * frame per durable append batch. Node's zstdDecompressSync decodes ONLY\n * the first frame\x2C so a single-shot decode undercounts every log that\n * received a turn (run 7: 12 frames\x2C 36KB\x2C "1 row" with single-shot).\n */\nconst ZSTD_MAGIC = 0xfd2fb528\nfunction scanZstdFrames(buffer) {\n  const frames = []\n  let offset = 0\n  while (offset < buffer.length) {\n    const start = offset\n    if (buffer.length - offset < 4) break\n    if (buffer.readUInt32LE(offset) !== ZSTD_MAGIC) break // torn tail: stop\n    offset += 4\n    if (offset === buffer.length) break\n    const descriptor = buffer.readUInt8(offset)\n    offset += 1\n    if ((descriptor & 0x18) !== 0) break // reserved bits: unreadable tail\n    const contentSizeFlag = descriptor >>> 6\n    const singleSegment = (descriptor & 0x20) !== 0\n    const checksum = (descriptor & 0x04) !== 0\n    const dictionaryFlag = descriptor & 0x03\n    const dictionaryBytes = dictionaryFlag === 3 ? 4 : dictionaryFlag\n    const contentSizeBytes = contentSizeFlag === 0\n      ? (singleSegment ? 1 : 0)\n      : 1 << contentSizeFlag\n    const remainingHeaderBytes = (singleSegment ? 0 : 1) + dictionaryBytes + contentSizeBytes\n    if (buffer.length - offset < remainingHeaderBytes) break\n    offset += remainingHeaderBytes\n    let complete = false\n    for (;;) {\n      if (buffer.length - offset < 3) break\n      const blockHeader = buffer.readUIntLE(offset\x2C 3)\n      offset += 3\n      const lastBlock = (blockHeader & 1) !== 0\n      const blockType = (blockHeader >>> 1) & 0x03\n      const blockSize = blockHeader >>> 3\n      if (blockType === 0x03) break // reserved: unreadable\n      const payloadBytes = blockType === 0x01 ? 1 : blockSize\n      if (buffer.length - offset < payloadBytes) break\n      offset += payloadBytes\n      if (lastBlock) { complete = true; break }\n    }\n    if (!complete) break\n    if (checksum) {\n      if (buffer.length - offset < 4) break\n      offset += 4\n    }\n    frames.push({ start\x2C end: offset })\n  }\n  return frames\n}\n\n/**\n * Read every complete JSONL row of one session generation file\n * (zstd multi-frame or plain JSONL). Returns { rows\x2C assistant\x2C rowTypes }.\n */\nfunction readSessionLogRows(path) {\n  let raw = readFileSync(path)\n  if (path.endsWith('.zstd')) {\n    const ranges = scanZstdFrames(raw)\n    const parts = []\n    for (const r of ranges) {\n      try { parts.push(zstdDecompressSync(raw.subarray(r.start\x2C r.end)).toString('utf8')) }\n      catch { break } // unreadable frame: keep the decodable prefix\n    }\n    raw = Buffer.from(parts.join('')\x2C 'utf8')\n  }\n  const rowTypes = []\n  let total = 0\n  let assistant = 0\n  for (const line of raw.toString('utf8').split('\\n')) {\n    if (line.length === 0) continue\n    total += 1\n    try {\n      const row = JSON.parse(line)\n      const role = row?.role ?? row?.type ?? row?.message?.role\n      rowTypes.push(String(role ?? '?'))\n      // v4 event rows: the assistant turn row is type `assistant/message`\n      // (legacy role rows were `assistant`).\n      if (role === 'assistant' || role === 'assistant/message') assistant += 1\n    } catch { rowTypes.push('!') }\n  }\n  return { rows: total\x2C assistant\x2C rowTypes }\n}\nfunction countAssistantRows(path) {\n  return readSessionLogRows(path)\n}\n\n// \u2500\u2500 the main scripted flow \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nasync function runBoot({ bootNo\x2C phase\x2C probeReject\x2C autoArm = false\x2C instanceLog\x2C tag\x2C detached = false\x2C expectLiveRoot = BOOT_ROOT }) {\n  writePatchFile(phase\x2C probeReject\x2C autoArm)\n  writeDirective(bootNo\x2C phase)\n  // Fresh per-boot probe event log (the JSONL is append-only across boots\n  // within a run; per-boot analysis wants clean boundaries).\n  rmSync(join(EVIDENCE_DIR\x2C 'probe-events'\x2C 'fence-probe-events.jsonl')\x2C { force: true })\n  const { child\x2C alive } = spawnHost({ port: HOST_PORT\x2C logPath: instanceLog\x2C detached })\n  const bootLine = await waitForLogLine(instanceLog\x2C BOOT_MARKER\x2C 300_000\x2C alive)\n  if (bootLine === null) {\n    stopHost(child)\n    die(`boot ${bootNo} failed: no boot marker within 300s\\n--- log tail ---\\n${logTail(instanceLog)}`)\n    return null\n  }\n  const m = BOOT_MARKER.exec(bootLine)\n  const origin = `http://127.0.0.1:${m[1]}`\n  writeEvidence(tag\x2C `boot-${bootNo}-marker.txt`\x2C bootLine + '\\n')\n  const token = m[0].split('token=')[1]\n  const cookie = await authenticate(origin\x2C token).catch((e) => {\n    stopHost(child)\n    die(`boot ${bootNo} auth failed: ${e.message}`)\n    return null\n  })\n  if (cookie === null) return null\n  // Row readiness: p6t6 health (the latched setupError gate) + fence probe\n  // health + the boot root live on the Team surface (bootstrap\x2C including\n  // the boot-root resume/creation\x2C is complete).\n  const deadline = Date.now() + 240_000\n  let health = null\n  for (;;) {\n    health = await fetchJson(`${origin}/__p6t6/health`\x2C undefined\x2C 15_000)\n    const ok = health.status === 200 && health.body?.ok === true\n    const rootLive = Array.isArray(health.body?.liveSessions) && health.body.liveSessions.includes(expectLiveRoot)\n    if (ok && rootLive) break\n    if (health.status === 200 && health.body?.ok === false && health.body?.setupError !== undefined) {\n      stopHost(child)\n      die(`boot ${bootNo} row setup failed \u2014 setupError: ${String(health.body.setupError).slice(0\x2C 600)}\\n--- log tail ---\\n${logTail(instanceLog)}`)\n      return null\n    }\n    if (!alive()) break\n    if (Date.now() >= deadline) {\n      stopHost(child)\n      die(`boot ${bootNo}: p6t6 health / boot root never live within 240s (last health: ${JSON.stringify(health.body ?? {}).slice(0\x2C 300)})\\n--- log tail ---\\n${logTail(instanceLog)}`)\n      return null\n    }\n    await sleep(500)\n  }\n  const fence = await fenceHealth(origin)\n  if (fence.status !== 200 || fence.body?.ok !== true) {\n    stopHost(child)\n    die(`boot ${bootNo}: fence probe health failed: ${JSON.stringify(fence).slice(0\x2C 300)}`)\n    return null\n  }\n  check(tag\x2C `boot ${bootNo} up (marker + auth + p6t6 ok + boot root live + fence probe ok\x2C probeReject=${probeReject})`\x2C true\x2C `${origin} liveSessions=${JSON.stringify(health.body.liveSessions)}`)\n  return { origin\x2C cookie\x2C child\x2C alive\x2C instanceLog }\n}\n\nasync function bootWorldAndInstall() {\n  // World reuse is EXPLICIT (RST017_WORLD) and only safe after a run whose\n  // boot 1 leg completed: a crashed boot 1 leaves a stamped team_domain in\n  // the home's storage\x2C which a bootPhase 'create' boot then rejects.\n  let installed = false\n  try {\n    const pk = JSON.parse(readFileSync(join(PROFILE_DIR\x2C 'package.json')\x2C 'utf8'))\n    installed = Array.isArray(pk?.dsh?.profile?.bundles) && pk.dsh.profile.bundles.includes('dsh-agent-team')\n  } catch { /* fresh world */ }\n  const domainStamped = existsSync(join(HOME\x2C 'storages'\x2C 'team_domain.json'))\n  if (installed && !domainStamped) {\n    log(`reusing installed\x2C domain-unstamped world: ${HOME}`)\n    return\n  }\n  rmSync(HOME\x2C { recursive: true\x2C force: true })\n  mkdirSync(WORKSPACE\x2C { recursive: true })\n  mkdirSync(join(WORKSPACE\x2C 'team')\x2C { recursive: true })\n  mkdirSync(BLUEPRINT_DIR\x2C { recursive: true })\n  mkdirSync(SPILL_ROOT\x2C { recursive: true })\n  mkdirSync(XDG\x2C { recursive: true })\n  writeFileSync(PROBE_TEAM_FILE\x2C PROBE_TEAM_CONTENT + '\\n')\n  writeFileSync(join(BLUEPRINT_DIR\x2C 'rst017-main.yaml')\x2C mainBlueprintYaml())\n  writeEvidence('world'\x2C 'materialized.json'\x2C { home: HOME\x2C workspace: WORKSPACE\x2C blueprintDir: BLUEPRINT_DIR\x2C stamp: RUN_STAMP })\n  log(`world materialized: ${HOME}`)\n\n  rmSync(REPO_GIT\x2C { recursive: true\x2C force: true })\n  const clone = spawnSync('git'\x2C ['clone'\x2C '--bare'\x2C '--branch'\x2C BRANCH\x2C MAIN_REPO\x2C REPO_GIT]\x2C { encoding: 'utf8'\x2C timeout: 120_000 })\n  if (clone.status !== 0) die(`git clone --bare failed: ${String(clone.stderr ?? clone.stdout).slice(0\x2C 400)}`)\n  const env = {\n    ...process.env\x2C\n    DSH_HOME: HOME\x2C\n    DSH_CLIENT_COMMIT_HASH: TESTUSE_PIN.slice(0\x2C 10)\x2C\n    XDG_DATA_HOME: join(XDG\x2C 'data')\x2C\n    XDG_CACHE_HOME: join(XDG\x2C 'cache')\x2C\n  }\n  const add = spawnSync(\n    process.execPath\x2C\n    [HOST_BIN\x2C 'plugin'\x2C '--profile'\x2C 'web'\x2C 'add'\x2C `git+file://${REPO_GIT}#${BRANCH}`]\x2C\n    { cwd: HOME\x2C encoding: 'utf8'\x2C maxBuffer: 256 * 1024 * 1024\x2C timeout: 600_000\x2C env }\x2C\n  )\n  const addOut = `# exit=${add.status}\\n# stdout\\n${add.stdout ?? ''}\\n# stderr\\n${add.stderr ?? ''}\\n`\n  writeEvidence('install'\x2C 'add.log'\x2C addOut)\n  const all = `${add.stdout ?? ''}\\n${add.stderr ?? ''}`\n  check('install'\x2C 'S1 `dsh plugin add` exits 0 (0.1.7 compat gate passes on the declared peer)'\x2C add.status === 0\x2C `exit=${add.status}`)\n  check('install'\x2C 'S1 no 0.1.7 incompat / allow-version exemption line'\x2C !/incompatible|allow-version/i.test(all)\x2C '')\n  check('install'\x2C 'S1 no ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED'\x2C !/ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED/.test(all)\x2C '')\n  if (fatal !== null) return\n\n  let profilePkg = null\n  try { profilePkg = JSON.parse(readFileSync(join(PROFILE_DIR\x2C 'package.json')\x2C 'utf8')) } catch { /* not yet */ }\n  const bundles = profilePkg?.dsh?.profile?.bundles ?? []\n  check('install'\x2C 'S2 dsh.profile.bundles auto-contains dsh-agent-team (CLI reconcile)'\x2C bundles.includes('dsh-agent-team')\x2C `bundles=${JSON.stringify(bundles)}`)\n  const inst = join(PROFILE_DIR\x2C 'node_modules'\x2C 'dsh-agent-team')\n  const artifacts = [\n    'packages/runtime/dist/packages/runtime/src/plugin/host.js'\x2C\n    'packages/runtime/dist/packages/runtime/src/plugin/live/agent-bindings.mjs'\x2C\n    'cordis.patch.yml'\x2C\n  ]\n  const missing = artifacts.filter((a) => !existsSync(join(inst\x2C a)))\n  check('install'\x2C 'S3 installed package dir carries the committed install surface'\x2C missing.length === 0\x2C missing.length === 0 ? 'all present' : `missing=${JSON.stringify(missing)}`)\n}\n\n/**\n * Wait until the mock request log carries a request (received at/after\n * `sinceAt`) whose last user text includes `needle`.\n */\n/**\n * @param {string} needle \u2014 required substring in a user message.\n * @param {string|null} sinceAt \u2014 optional ISO lower bound on receivedAt.\n *   CAUTION: a turn driven by an awaited remote call (e.g. team.create's\n *   initialWork) makes its model request BEFORE the call's HTTP response \u2014\n *   do not filter with the post-response timestamp for such turns.\n * @param {string} userTextStartsWith \u2014 optional raw user-text prefix; pins\n *   the leader's turn request and excludes the session title-generation\n *   request\x2C which embeds the same human text JSON-wrapped (run 6: the\n *   title request carried the needle and 0 tools).\n */\nasync function waitForMockRequest(mock\x2C needle\x2C timeoutMs\x2C label\x2C sinceAt = null\x2C userTextStartsWith = null) {\n  const deadline = Date.now() + timeoutMs\n  const matches = () => mock.requests.find((r) => {\n    if (sinceAt !== null && (r.receivedAt ?? '') < sinceAt) return false\n    const body = r.body\n    const msgs = body?.messages ?? []\n    const userTexts = msgs.filter((m) => m?.role === 'user')\n      .map((m) => (typeof m.content === 'string' ? m.content\n        : Array.isArray(m.content) ? m.content.filter((b) => b?.type === 'text').map((b) => b.text ?? '').join('')\n        : ''))\n      .filter((t) => t.length > 0)\n    return userTexts.some((t) => t.includes(needle) && (userTextStartsWith === null || t.startsWith(userTextStartsWith)))\n  })\n  for (;;) {\n    const hit = matches()\n    if (hit !== undefined) return hit\n    if (Date.now() >= deadline) {\n      // Diagnostic dump: what the mock DID receive (root-causes missed\n      // needles \u2014 run 5 saw 2 requests with no MK_DONE match).\n      const dump = mock.requests.map((r) => {\n        const msgs = r.body?.messages ?? []\n        const userTexts = msgs.filter((m) => m?.role === 'user')\n          .map((m) => (typeof m.content === 'string' ? m.content\n            : Array.isArray(m.content) ? m.content.filter((b) => b?.type === 'text').map((b) => b.text ?? '').join('')\n            : ''))\n          .filter((t) => t.length > 0)\n        return {\n          seq: r.seq\x2C path: r.path\x2C status: r.status\x2C error: r.error ?? null\x2C\n          model: r.body?.model ?? null\x2C tools: (r.body?.tools ?? []).length\x2C\n          systemHead: String(r.body?.system ?? '').slice(0\x2C 200)\x2C\n          userTextsHead: userTexts.map((t) => t.slice(0\x2C 200))\x2C\n          userTextsTail: userTexts.map((t) => t.slice(-200))\x2C\n          receivedAt: r.receivedAt\x2C\n        }\n      })\n      writeEvidence('diagnostics'\x2C `mock-requests-at-timeout-${label.replace(/[^a-z0-9]+/gi\x2C '-')}.json`\x2C { label\x2C needle\x2C sinceAt\x2C count: mock.requests.length\x2C requests: dump })\n      log(`waitForMockRequest timeout: ${label} (requests so far: ${mock.requests.length} \u2014 dumped to diagnostics/)`)\n      return null\n    }\n    await sleep(250)\n  }\n}\nfunction mockToolsOf(record) {\n  const body = record.body\n  return (body?.tools ?? []).map((t) => t.function?.name ?? t.name ?? String(t))\n}\n\nasync function main() {\n  mkdirSync(EVIDENCE_DIR\x2C { recursive: true })\n  log(`Phase 0 spike \u2014 stamp ${RUN_STAMP} (keep=${KEEP_MODE})`)\n\n  // \u2500\u2500 S0 preflight \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  const rev = spawnSync('git'\x2C ['rev-parse'\x2C 'HEAD']\x2C { cwd: TESTUSE\x2C encoding: 'utf8' })\n  if (rev.status !== 0 || rev.stdout.trim() !== TESTUSE_PIN) {\n    die(`test-use checkout is not at ${TESTUSE_PIN} (got ${rev.stdout?.trim() ?? rev.stderr})`)\n    return finish(1)\n  }\n  const porcelain = spawnSync('git'\x2C ['status'\x2C '--porcelain']\x2C { cwd: TESTUSE\x2C encoding: 'utf8' }).stdout\n  if (porcelain !== '') die(`test-use working tree is NOT pristine: ${porcelain.slice(0\x2C 300)}`)\n  const wtRev = spawnSync('git'\x2C ['rev-parse'\x2C 'HEAD']\x2C { cwd: WORKTREE\x2C encoding: 'utf8' })\n  check('s0'\x2C 'preflight: test-use pristine @ 46a7f68b09 (HEAD + empty porcelain)'\x2C true\x2C '')\n  check('s0'\x2C 'preflight: task worktree on task/team-restart-017rc1'\x2C wtRev.status === 0\x2C `HEAD=${wtRev.stdout.trim()}`)\n  const cliVersion = spawnSync(process.execPath\x2C [HOST_BIN\x2C '--version']\x2C { cwd: TESTUSE\x2C encoding: 'utf8'\x2C timeout: 60_000 }).stdout.trim()\n  check('s0'\x2C 'preflight: the test-use CLI reports 0.1.7-rc.1'\x2C cliVersion === '0.1.7-rc.1'\x2C `version=${cliVersion}`)\n  const preStable = { p3080: await probePort(3080)\x2C p3180: await probePort(3180) }\n  writeEvidence('s0-preflight'\x2C 'pre-stable-probe.json'\x2C preStable)\n  log(`stable pre-probe: 3080=${preStable.p3080.reachable ? preStable.p3080.status : 'unreachable'} 3180=${preStable.p3180.reachable ? preStable.p3180.status : 'unreachable'}`)\n  if (fatal !== null) return finish(1)\n\n  // \u2500\u2500 world + install \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  await bootWorldAndInstall()\n  if (fatal !== null) return finish(1)\n\n  if (!(await waitForPortFree(MOCK_PORT\x2C 60_000))) die(`mock port ${MOCK_PORT} not free within 60s (leftover process?)`)\n  const mock = await startMockModel()\n  log(`mock model up @ ${MOCK_PORT}`)\n\n  let boot3 = null\n  let liveHost = null // the currently-running boot child (teardown on unexpected error)\n\n  try {\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n    // Leg A \u2014 baseline on the CURRENT production code\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n    log('\u2500\u2500 Leg A: boot 1 (create) + dynamic team \u2500\u2500')\n    const instanceLog1 = writeEvidence('legA'\x2C 'instance-1.log'\x2C '')\n    const boot1 = await runBoot({ bootNo: 1\x2C phase: 'create'\x2C probeReject: false\x2C instanceLog: instanceLog1\x2C tag: 'legA' })\n    if (boot1 === null) return finish(1)\n    liveHost = boot1\n    const { origin: o1\x2C cookie: c1 } = boot1\n\n    // v1 team.create carries initialWork inline (the U8-proven 0.1.7 path).\n    const createRes = await remoteCall(o1\x2C c1\x2C 'team.create'\x2C {\n      rootSessionId: DYN_ROOT\x2C\n      blueprintId: BP_MAIN_ID\x2C\n      initialWork: { prompt: `Spike dynamic team created. Answer with the token ${MK_DONE} and stop.` }\x2C\n    }\x2C 'rst-create'\x2C 1)\n    writeEvidence('legA'\x2C 'team-create-response.json'\x2C createRes)\n    const createOk = createRes.status === 200 && createRes.body !== null\n    check('legA'\x2C 'A1 team.create(R1) accepted over the public remote seam'\x2C createOk\x2C `status=${createRes.status} bodyHead=${JSON.stringify(createRes.body ?? {}).slice(0\x2C 200)}`)\n    if (!createOk) {\n      die(`team.create failed \u2014 see legA/team-create-response.json + instance log tail:\\n${logTail(instanceLog1\x2C 30)}`)\n      return finish(1)\n    }\n    // No sinceAt here: the initial-work turn's model request lands BEFORE\n    // the team.create HTTP response (the handler awaits the whole turn)\x2C\n    // so a post-response timestamp would filter out the very request we\n    // want (run 6 root cause). The prefix pins the leader's turn and\n    // excludes the title-generation request that embeds the same text.\n    const dynFirst = await waitForMockRequest(mock\x2C MK_DONE\x2C 120_000\x2C 'dynamic leader first turn'\x2C null\x2C '[team-root-work')\n    const dynFirstTools = dynFirst !== null ? mockToolsOf(dynFirst) : []\n    writeEvidence('legA'\x2C 'dyn-leader-first-request.json'\x2C dynFirst === null ? { absent: true } : { seq: dynFirst.seq\x2C model: dynFirst.body?.model\x2C tools: dynFirstTools\x2C systemHead: String(dynFirst.body?.system ?? '').slice(0\x2C 400) })\n    // Diagnostic (run 5: no model request\x2C and the dyn session log held\n    // ONLY the envelope row \u2014 the initial-work turn never started a turn\n    // boundary; a zstd-aware dump pins down what the log actually holds).\n    writeEvidence('legA'\x2C 'dyn-session-log-after-A2.json'\x2C findSessionLogs(HOME\x2C DYN_ROOT).map((p) => ({ path: p\x2C ...countAssistantRows(p) })))\n    writeEvidence('legA'\x2C 'boot-session-log-after-A2.json'\x2C findSessionLogs(HOME\x2C BOOT_ROOT).map((p) => ({ path: p\x2C ...countAssistantRows(p) })))\n    check('legA'\x2C 'A2 dynamic leader live: first model request observed (row staticModel)'\x2C\n      dynFirst !== null && dynFirst.body?.model === MODEL_ID\x2C\n      `seq=${dynFirst?.seq} model=${dynFirst?.body?.model}`)\n    check('legA'\x2C 'A3 dynamic leader surface carries the team tools (legacy-mode full catalog)'\x2C\n      dynFirstTools.some((t) => String(t).startsWith('team_'))\x2C `tools=${JSON.stringify(dynFirstTools).slice(0\x2C 300)}`)\n    stopHost(boot1.child)\n    liveHost = null\n    await waitForPortFree(HOST_PORT)\n    log('boot 1 stopped (SIGTERM)')\n\n    log('\u2500\u2500 Leg A: boot 2 (resume) \u2014 the cold dynamic root \u2500\u2500')\n    const instanceLog2 = writeEvidence('legA'\x2C 'instance-2.log'\x2C '')\n    const boot2 = await runBoot({ bootNo: 2\x2C phase: 'resume'\x2C probeReject: false\x2C instanceLog: instanceLog2\x2C tag: 'legA' })\n    if (boot2 === null) return finish(1)\n    liveHost = boot2\n    const { origin: o2\x2C cookie: c2 } = boot2\n\n    const probeBaselineA = (await fenceEvents(o2)).length\n    writeEvidence('legA'\x2C 'probe-baseline-after-boot2.json'\x2C { count: probeBaselineA })\n\n    const wsA = await openMux(o2\x2C c2\x2C 'legA-follow')\n    await openEventsStream(wsA)\n    const followA = await followSession(wsA\x2C DYN_ROOT).catch((e) => ({ error: String(e?.message ?? e) }))\n    writeEvidence('legA'\x2C 'follow-dyn-root.json'\x2C followA.error !== undefined ? { error: followA.error } : { snapshotType: followA.snapshot?.type })\n    check('legA'\x2C 'A4 browser-equivalent session/follow(R1) yields the snapshot frame (the stream survives)'\x2C\n      followA.error === undefined\x2C followA.error !== undefined ? followA.error : 'snapshot ok')\n    // RUN-10: explicit socket-survival check (run 9 A4 reported a spurious\n    // "ws closed by host"; repro1/2/4/5 prove the host never closes a follow\n    // socket \u2014 this check pins that on the spike's own socket).\n    check('legA'\x2C 'A4b the mux socket is still open after the follow (no host-side close)'\x2C\n      wsA.closed === false\x2C `closed=${wsA.closed}`)\n    dumpWsTraces('legA')\n\n    let promoted = false\n    {\n      const deadline = Date.now() + 45_000\n      for (;;) {\n        const events = await fenceEvents(o2)\n        if (events.slice(probeBaselineA).some((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT)) { promoted = true; break }\n        if (Date.now() >= deadline) break\n        await sleep(250)\n      }\n    }\n    const eventsA = await fenceEvents(o2)\n    writeEvidence('legA'\x2C 'probe-events-after-follow.json'\x2C { baseline: probeBaselineA\x2C events: eventsA.slice(probeBaselineA) })\n    check('legA'\x2C 'A5 ordinary promotion observed: agent/created(R1\x2C source=resume) fired unvetoed (the stock path)'\x2C\n      promoted\x2C JSON.stringify(eventsA.slice(probeBaselineA).map((e) => ({ kind: e.kind\x2C sid: String(e.sessionId ?? '').slice(-12)\x2C source: e.source\x2C veto: e.veto }))).slice(0\x2C 400))\n\n    // THE baseline blocker: the Team's own resume now collides.\n    const ensureA = await remoteCall(o2\x2C c2\x2C 'team.ensureRootLive'\x2C { teamSessionId: DYN_ROOT }\x2C 'rst-ensureA'\x2C 3)\n    writeEvidence('legA'\x2C 'ensure-root-live-baseline.json'\x2C ensureA)\n    const ensureAErr = JSON.stringify(ensureA.body ?? {})\n    const outsideTeam = ensureAErr.includes('already registered') || ensureAErr.includes('OUTSIDE_TEAM')\n    // Run 8 baseline: the stock writer-held collision surfaces as the\n    // SessionAlreadyOwnedError message "session ... is already owned by an\n    // active write handle" (wrapped in TEAM_REMOTE_TEAM_ROOT_LIVE_START_FAILED).\n    const writerHeld = ensureAErr.includes('writer-held') || ensureAErr.includes('SessionAlreadyOwned') || ensureAErr.includes('already owned by an active write handle')\n    check('legA'\x2C 'A6 BASELINE BLOCKER: team.ensureRootLive(R1) FAILS after the ordinary promotion stole the session'\x2C\n      ensureA.status !== 200 || ensureAErr.includes('"ok":false') || ensureAErr.includes('error')\x2C\n      `status=${ensureA.status} errHead=${ensureAErr.slice(0\x2C 300)}`)\n    check('legA'\x2C 'A6b baseline failure lane: typed OUTSIDE_TEAM (already registered) or the writer-held race'\x2C\n      outsideTeam || writerHeld\x2C `outsideTeam=${outsideTeam} writerHeld=${writerHeld}`)\n    wsA.close()\n    stopHost(boot2.child)\n    liveHost = null\n    await waitForPortFree(HOST_PORT)\n    log('boot 2 stopped (SIGTERM)')\n\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n    // Leg B \u2014 the fence probe (the C1 premise)\n    // \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n    log('\u2500\u2500 Leg B: boot 3 (resume\x2C fence reject=true) \u2500\u2500')\n    const instanceLog3 = writeEvidence('legB'\x2C 'instance-3.log'\x2C '')\n    boot3 = await runBoot({ bootNo: 3\x2C phase: 'resume'\x2C probeReject: true\x2C autoArm: true\x2C instanceLog: instanceLog3\x2C tag: 'legB'\x2C detached: KEEP_MODE })\n    if (boot3 === null) return finish(1)\n    liveHost = boot3\n    const { origin: o3\x2C cookie: c3 } = boot3\n\n    // B0: the boot team root re-adopts on restart (already live \u2014 the boot\n    // gate above waited for it); its agent/created must NOT have been\n    // vetoed (the fence only targets the configured dynamic root). The\n    // probe state is fresh per host process (the JSONL is cleared per boot\n    // too)\x2C so the FULL state is this boot's log.\n    const allEventsB = await fenceEvents(o3)\n    const bootCreated = allEventsB.find((e) => e.kind === 'agent/created' && e.sessionId === BOOT_ROOT) ?? null\n    writeEvidence('legB'\x2C 'boot3-boot-root-events.json'\x2C { events: allEventsB })\n    check('legB'\x2C 'B0 boot team root re-adopted on restart and NOT vetoed by the fence'\x2C\n      bootCreated !== null && bootCreated.veto !== true\x2C\n      JSON.stringify(allEventsB.map((e) => ({ kind: e.kind\x2C sid: String(e.sessionId ?? '').slice(-12)\x2C source: e.source\x2C veto: e.veto }))).slice(0\x2C 400))\n\n    // B1: the fence was ARMED AT ROW LOAD (autoArm) \u2014 before the stock\n    // host's boot-time session re-adoption \u2014 and the stock host's re-adopt\n    // of the dynamic root (source=resume\x2C boot-time \u2014 the run-8 discovery:\n    // the stock host re-adopts every previously-live session at boot\x2C and\n    // that re-adoption is the writer steal\x2C not only the browser follow)\n    // has ALREADY been vetoed by the time the boot gate returns.\n    const healthB = await fenceHealth(o3)\n    // RUN-10 FIX (run 9 B1a false negative): the boot-gate event snapshot\n    // (allEventsB\x2C taken at the B0 point) can land BEFORE the glue's DYN\n    // boot-resume veto (repro5 timeline: BOOT_ROOT re-adopt \u2192 DYN veto\n    // ~150-600 ms later; the gate can return in that gap). Settle-wait for\n    // the DYN agent/created event\x2C then re-snapshot before the B1a check.\n    {\n      const deadline = Date.now() + 60_000\n      for (;;) {\n        const evs = await fenceEvents(o3)\n        if (evs.some((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT)) break\n        if (Date.now() >= deadline) break\n        await sleep(250)\n      }\n    }\n    const bootVeto = (await fenceEvents(o3)).find((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT && e.veto === true) ?? null\n    writeEvidence('legB'\x2C 'boot3-autoarm-health.json'\x2C healthB.body ?? null)\n    check('legB'\x2C 'B1 fence auto-armed at row load (before the stock boot re-adoption)'\x2C\n      healthB.status === 200 && healthB.body?.armed === true\x2C JSON.stringify(healthB.body ?? {}).slice(0\x2C 200))\n    check('legB'\x2C 'B1a BOOT-VETO: the stock host boot-time re-adopt of R1 was vetoed (source=resume) \u2014 the writer steal caught at the origin'\x2C\n      bootVeto !== null && bootVeto.source === 'resume'\x2C JSON.stringify(bootVeto ?? null).slice(0\x2C 250))\n\n    if (KEEP_MODE) {\n      writeEvidence('legB'\x2C 'keep-mode.json'\x2C {\n        note: 'boot 3 held alive for the manual browser Q2 leg. Steps: (1) open the marker URL in a browser (legB/boot-3-marker.txt); (2) open the cold dynamic session (fence vetoes the ordinary promotion \u2192 api-session/error lands on the client); (3) observe the error lane (screenshot); (4) click \u4ee5 Team \u6a21\u5f0f \u6253\u5f00 (takeover); (5) observe whether the error persists after the successful takeover (screenshot); (6) kill -TERM the printed kit PID \u2014 the kit then writes the final verdict and tears the world down.'\x2C\n        kitPid: process.pid\x2C\n        gui: o3\x2C\n        dynamicRoot: DYN_ROOT\x2C\n      })\n      log(`KEEP MODE: boot 3 alive at ${o3} (fence auto-armed). Kit PID ${process.pid} \u2014 do the browser leg\x2C then: kill -TERM ${process.pid}`)\n      // The PROBE is a flat reject; the production C1 fence passes the\n      // Team's OWN activation through (runOwned ownedDepth>0). Emulate that\n      // for the browser's \u4ee5 Team \u6a21\u5f0f \u6253\u5f00 click: grant the one-shot permit\n      // when the BROWSER-TRIGGERED foreign veto lands (not the boot-time\n      // one \u2014 the boot veto predates any human; the 15s guard after the\n      // keep banner separates the two). The subsequent Team-mode takeover\n      // then consumes the permit and passes\x2C so the Q2 question (error-lane\n      // persistence AFTER a successful takeover) stays observable.\n      const keepBannerAt = Date.now()\n      void (async () => {\n        for (;;) {\n          const evs = await fenceEvents(o3).catch(() => [])\n          const browserVeto = evs.find((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT && e.veto === true && new Date(e.t).getTime() > keepBannerAt + 15_000)\n          if (browserVeto !== undefined) {\n            const per = await fencePermit(o3\x2C DYN_ROOT).catch(() => null)\n            log('KEEP MODE: browser-triggered veto observed \u2014 one-shot permit granted for the Team-mode takeover click')\n            writeEvidence('legB'\x2C 'keep-permit-after-veto.json'\x2C { at: new Date().toISOString()\x2C veto: browserVeto\x2C permitted: per?.status === 200 && (per?.body?.permits ?? []).includes(DYN_ROOT) })\n            return\n          }\n          await sleep(250)\n        }\n      })()\n      await new Promise((resolveHold) => {\n        process.once('SIGTERM'\x2C resolveHold)\n        process.once('SIGINT'\x2C resolveHold)\n      })\n      log('hold released (SIGTERM) \u2014 collecting keep-mode evidence')\n    } else {\n      // Wire-mode leg B: the script plays the browser.\n      // RUN-10 FIX: the B1a settle-wait above means the boot veto is\n      // SETTLED before this socket opens \u2014 the follow's OWN background\n      // promote is the only in-flight resume (repro5-runA ground truth: it\n      // gets its own veto + its own api-session/error; the snapshot is\n      // yielded FIRST and the socket/stream survive the rejection).\n      markActivity('B2 openMux')\n      const wsB = await openMux(o3\x2C c3\x2C 'legBC-follow')\n      markActivity('B2 openEventsStream')\n      const evBId = await openEventsStream(wsB)\n      markActivity('B2 followSession')\n      const followB = await followSession(wsB\x2C DYN_ROOT).catch((e) => ({ error: String(e?.message ?? e) }))\n      writeEvidence('legB'\x2C 'follow-dyn-root.json'\x2C followB.error !== undefined ? { error: followB.error } : { snapshotType: followB.snapshot?.type })\n      check('legB'\x2C 'B2 session/follow(R1) snapshot arrives before the (background) promotion veto'\x2C\n        followB.error === undefined\x2C followB.error !== undefined ? followB.error : 'snapshot ok')\n      // B2b: the stream SURVIVES the veto \u2014 the api-session/error frame for\n      // the follow's own rejected promote must arrive ON THIS SOCKET (the\n      // browser's data path) after the snapshot.\n      markActivity('B2 check done')\n      markActivity('B2b wait start')\n      const vetoFrameB = await waitForEventFrame(wsB\x2C evBId\x2C\n        (v) => v.event === 'api-session/error' && Array.isArray(v.args) && v.args[0] === DYN_ROOT\x2C 30_000)\n      markActivity('B2b wait end')\n      check('legB'\x2C 'B2b the follow stream survives the rejection (the follow promote\\u2019s api-session/error arrives on the same socket after the snapshot)'\x2C\n        vetoFrameB !== null\x2C JSON.stringify(vetoFrameB ?? null).slice(0\x2C 300))\n      // B2c: the mux socket itself is still open (repro4/repro5 ground\n      // truth: the host never closes a follow socket; run 8/9's\n      // "ws closed by host" is not reproducible in any isolated shape).\n      check('legB'\x2C 'B2c the mux socket is still open after the rejection (no host-side close)'\x2C\n        wsB.closed === false\x2C `closed=${wsB.closed}`)\n      dumpWsTraces('legB')\n\n      // Q1 evidence: the FIRST veto of this boot is the boot-time one (B1a);\n      // the follow's promotion\x2C if it fired\x2C was vetoed second. The probe\n      // state is fresh per boot\x2C so scan the whole state (first match wins).\n      const q1 = { veto: null\x2C disposed: null\x2C apiError: null\x2C deadline: Date.now() + 60_000 }\n      for (;;) {\n        markActivity('q1 poll')\n        const events = await fenceEvents(o3)\n        q1.veto ??= events.find((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT && e.veto === true) ?? null\n        q1.disposed ??= events.find((e) => e.kind === 'agent/disposed' && e.sessionId === DYN_ROOT) ?? null\n        q1.apiError ??= events.find((e) => e.kind === 'api-session/error' && e.sessionId === DYN_ROOT) ?? null\n        if (q1.veto !== null && q1.disposed !== null && q1.apiError !== null) break\n        if (Date.now() >= q1.deadline) break\n        await sleep(250)\n      }\n      const eventsB = await fenceEvents(o3)\n      writeEvidence('legB'\x2C 'q1-events.json'\x2C { q1\x2C all: eventsB })\n      check('legB'\x2C 'B3 Q1: the fence veto fired on agent/created (source=resume)'\x2C\n        q1.veto !== null && q1.veto.source === 'resume'\x2C JSON.stringify(q1.veto ?? null).slice(0\x2C 250))\n      check('legB'\x2C 'B4 Q1: agent/disposed arrived for the vetoed session (rollback completed)'\x2C\n        q1.disposed !== null\x2C JSON.stringify(q1.disposed ?? null).slice(0\x2C 200))\n      check('legB'\x2C 'B5 Q1: api-session/error surfaced (the SessionController promote() error surface\x2C broadcast on the wire)'\x2C\n        q1.apiError !== null\x2C JSON.stringify(q1.apiError ?? null).slice(0\x2C 300))\n\n      const mockCountAtVeto = mock.requests.length\n      writeEvidence('legB'\x2C 'q1-mock-at-veto.json'\x2C { count: mockCountAtVeto\x2C tail: mock.requests.slice(-5).map((r) => ({ seq: r.seq\x2C model: r.body?.model })) })\n\n      // B6: the fence STAYS ARMED \u2014 the Team glue's own activation passes\n      // through the one-shot permit (the production runOwned emulation)\x2C\n      // mirroring guide \xa73 (the owned guard is pass-through\x2C not disarm).\n      const permitRes = await fencePermit(o3\x2C DYN_ROOT)\n      check('legB'\x2C "B6 fence stays armed; one-shot permit granted for R1 (the Team's own activation passes via the permit)"\x2C\n        permitRes.status === 200 && (permitRes.body?.permits ?? []).includes(DYN_ROOT)\x2C JSON.stringify(permitRes.body ?? {}).slice(0\x2C 200))\n      const tAfterDisarm = new Date().toISOString()\n      // Determinism: the follow's own promotion was vetoed second; its\n      // AgentLoop rollback (store detach) must settle before the glue's\n      // resume\x2C or the agents store still holds the foreign entry and the\n      // resume collides. Wait for probe-event quiescence on R1 (3s).\n      {\n        const deadline = Date.now() + 30_000\n        let lastCount = -1\n        let stableSince = 0\n        for (;;) {\n          const evs = await fenceEvents(o3)\n          const n = evs.filter((e) => e.sessionId === DYN_ROOT).length\n          if (n === lastCount) {\n            if (stableSince === 0) stableSince = Date.now()\n            else if (Date.now() - stableSince >= 3_000) break\n          } else { lastCount = n; stableSince = 0 }\n          if (Date.now() >= deadline) break\n          await sleep(500)\n        }\n      }\n      const ensureB = await remoteCall(o3\x2C c3\x2C 'team.ensureRootLive'\x2C { teamSessionId: DYN_ROOT }\x2C 'rst-ensureB'\x2C 3)\n      writeEvidence('legB'\x2C 'ensure-root-live-after-rollback.json'\x2C ensureB)\n      const ensureBOk = ensureB.status === 200 && ensureB.body !== null && !JSON.stringify(ensureB.body).includes('"ok":false')\n      check('legB'\x2C 'B7 Q1: team.ensureRootLive(R1) SUCCEEDS after the rollback (the writer was released)'\x2C\n        ensureBOk\x2C `status=${ensureB.status} bodyHead=${JSON.stringify(ensureB.body ?? {}).slice(0\x2C 250)}`)\n\n      const eventsB2 = await fenceEvents(o3)\n      const teamResume = eventsB2.filter((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT && e.permitted === true)\n      writeEvidence('legB'\x2C 'team-takeover-events.json'\x2C { teamResumeEvents: teamResume })\n      check('legB'\x2C 'B8 the Team\\'s own resume fired exactly one permitted (non-vetoed) agent/created \u2014 the one-shot permit consumed by the owned activation'\x2C\n        teamResume.length === 1\x2C `count=${teamResume.length}`)\n\n      // Drive the takeover turn: ensureRootLive only resumes the agent; the\n      // model request happens on the next queued prompt (the Team leader\n      // answers it with the full team_* surface + Team model selection).\n      const promptB = await apiPrompt(o3\x2C c3\x2C DYN_ROOT\x2C `Takeover verification. Answer with the token ${MK_DONE} and stop.`\x2C 'rst-takeover')\n      writeEvidence('legB'\x2C 'takeover-prompt-response.json'\x2C promptB)\n      const dynTakeover = await waitForMockRequest(mock\x2C MK_DONE\x2C 120_000\x2C 'team takeover first turn'\x2C tAfterDisarm\x2C 'Takeover verification.')\n      const dynTakeoverTools = dynTakeover !== null ? mockToolsOf(dynTakeover) : []\n      writeEvidence('legB'\x2C 'team-takeover-first-request.json'\x2C dynTakeover === null ? { absent: true } : { seq: dynTakeover.seq\x2C model: dynTakeover.body?.model\x2C tools: dynTakeoverTools })\n      check('legB'\x2C 'B9 takeover turn live on the mock with the Team tools (full surface retained)'\x2C\n        dynTakeover !== null && dynTakeoverTools.some((t) => String(t).startsWith('team_'))\x2C\n        `seq=${dynTakeover?.seq} teamTools=${dynTakeoverTools.filter((t) => String(t).startsWith('team_')).length}/${dynTakeoverTools.length}`)\n      check('legB'\x2C 'B10 Q1: exactly one model request since the veto (the Team takeover turn \u2014 ZERO from the foreign agent)'\x2C\n        mock.requests.length - mockCountAtVeto === (dynTakeover !== null ? 1 : 0)\x2C\n        `requestsSinceVeto=${mock.requests.length - mockCountAtVeto}`)\n\n      const logs = findSessionLogs(HOME\x2C DYN_ROOT)\n      const logStats = logs.map((p) => ({ path: p\x2C ...countAssistantRows(p) }))\n      writeEvidence('legB'\x2C 'session-log-files.json'\x2C logStats)\n      check('legB'\x2C 'B11 session log intact and readable (durable rows present)'\x2C logs.length > 0 && logStats.every((s) => s.rows > 0)\x2C\n        `files=${logs.length} rows=${logStats.map((s) => s.rows).join('+')} assistantRows=${logStats.map((s) => s.assistant).join('+')}`)\n\n      // \u2500\u2500 Leg C: the ordinary negative control (fence ARMED\x2C unmanaged) \u2500\u2500\n      log('\u2500\u2500 Leg C: ordinary session negative control (fence armed) \u2500\u2500')\n      const armC = await fenceArmed(o3\x2C true)\n      check('legC'\x2C 'C0 fence re-armed for the ordinary control'\x2C armC.status === 200 && armC.body?.armed === true\x2C '')\n      // RUN-10 FIX: the ordinary session's agent/created fires with\n      // source=startup AT create-time (session/create starts the agent)\x2C so\n      // the fence baseline must be captured BEFORE the create \u2014 otherwise\n      // the creation event is already in the baseline and C3 sees `[]`.\n      const probeBaselineC = (await fenceEvents(o3)).length\n      const ordCreate = await apiCreateSession(o3\x2C c3\x2C ORD_SESSION\x2C WORKSPACE)\n      check('legC'\x2C 'C1 ordinary session created via the public seam'\x2C ordCreate.status === 200\x2C `status=${ordCreate.status} bodyHead=${JSON.stringify(ordCreate.body ?? {}).slice(0\x2C 150)}`)\n      let ordCreated = null\n      {\n        const deadline = Date.now() + 45_000\n        for (;;) {\n          const events = (await fenceEvents(o3)).slice(probeBaselineC)\n          ordCreated = events.find((e) => e.kind === 'agent/created' && e.sessionId === ORD_SESSION) ?? null\n          if (ordCreated !== null) break\n          if (Date.now() >= deadline) break\n          await sleep(250)\n        }\n      }\n      const eventsC = (await fenceEvents(o3)).slice(probeBaselineC)\n      writeEvidence('legC'\x2C 'probe-events-ordinary.json'\x2C eventsC)\n      check('legC'\x2C 'C3 ordinary promotion passed the ARMED fence (no veto for unmanaged sessions)'\x2C\n        ordCreated !== null && ordCreated.veto !== true\x2C\n        JSON.stringify(eventsC.map((e) => ({ kind: e.kind\x2C sid: String(e.sessionId ?? '').slice(-12)\x2C veto: e.veto }))).slice(0\x2C 300))\n      // RUN-10 FIX: Leg C opens its OWN socket. Run 9's C2/C3 were cascade\n      // artifacts \u2014 the kit reused wsB\x2C which B2's close had already killed\n      // ("immediate ws closed by host"\x2C C3 saw no promotion event).\n      const wsC = await openMux(o3\x2C c3\x2C 'legC-follow')\n      const followC = await followSession(wsC\x2C ORD_SESSION).catch((e) => ({ error: String(e?.message ?? e) }))\n      check('legC'\x2C 'C2 ordinary session/follow snapshot arrives (unaffected by the fence)'\x2C followC.error === undefined\x2C followC.error !== undefined ? followC.error : 'ok')\n      dumpWsTraces('legC')\n      check('legC'\x2C 'C2b the ordinary follow socket is still open (no host-side close)'\x2C wsC.closed === false\x2C `closed=${wsC.closed}`)\n      wsB.close()\n      wsC.close()\n    }\n\n    // \u2500\u2500 teardown + verdict \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    if (KEEP_MODE) {\n      // Final keep-mode evidence (the browser already did the Q2 leg).\n      const eventsK = (await fenceEvents(boot3.origin)).catch(() => [])\n      const probeJsonlPath = join(EVIDENCE_DIR\x2C 'probe-events'\x2C 'fence-probe-events.jsonl')\n      let probeJsonl = null\n      try { probeJsonl = readFileSync(probeJsonlPath\x2C 'utf8') } catch { /* absent */ }\n      writeEvidence('legB'\x2C 'keep-final-probe-events.json'\x2C eventsK)\n      if (probeJsonl !== null) writeEvidence('legB'\x2C 'keep-final-probe-events.jsonl'\x2C probeJsonl)\n      writeEvidence('legB'\x2C 'keep-final-mock-requests.json'\x2C mock.requests)\n      const logsK = findSessionLogs(HOME\x2C DYN_ROOT)\n      writeEvidence('legB'\x2C 'keep-session-log-files.json'\x2C logsK.map((p) => ({ path: p\x2C ...countAssistantRows(p) })))\n      const kDynCreated = eventsK.filter((e) => e.kind === 'agent/created' && e.sessionId === DYN_ROOT)\n      const kDynDisposed = eventsK.filter((e) => e.kind === 'agent/disposed' && e.sessionId === DYN_ROOT)\n      const kApiErrors = eventsK.filter((e) => e.kind === 'api-session/error' && e.sessionId === DYN_ROOT)\n      const kVetoed = kDynCreated.filter((e) => e.veto === true)\n      const kTeamResume = kDynCreated.filter((e) => e.veto !== true)\n      const kTakeover = await remoteCall(boot3.origin\x2C boot3.cookie\x2C 'team.ensureRootLive'\x2C { teamSessionId: DYN_ROOT }\x2C 'rst-keep-verify'\x2C 3).catch((e) => ({ status: 0\x2C body: { error: String(e?.message ?? e) } }))\n      writeEvidence('legB'\x2C 'keep-final-ensure-root-live.json'\x2C kTakeover)\n      const kMockSinceVeto = kVetoed.length > 0\n        ? mock.requests.filter((r) => (r.receivedAt ?? '') >= (kVetoed[0]?.t ?? '')).length\n        : mock.requests.length\n      const verdict = {\n        mode: 'keep (browser Q2 leg done manually)'\x2C\n        q1_writerReleased: kVetoed.length > 0 && kDynDisposed.length >= kVetoed.length\x2C\n        q1_takeoverSucceeded: kTakeover.status === 200\x2C\n        q1_teamResumeObserved: kTeamResume.length > 0\x2C\n        q1_modelRequestsAfterFirstVeto: kMockSinceVeto\x2C\n        q2_wireApiSessionError: kApiErrors[0] ?? null\x2C\n        q2_browserPersistent: 'OBSERVED MANUALLY \u2014 record the observation in the session report / browser-q2.md'\x2C\n      }\n      writeEvidence('verdict'\x2C 'q1-q2.json'\x2C verdict)\n      check('legB'\x2C 'K1 keep-mode Q1: veto + disposed + Team resume + takeover all recorded'\x2C\n        kVetoed.length > 0 && kDynDisposed.length >= kVetoed.length && kTeamResume.length > 0 && kTakeover.status === 200\x2C\n        JSON.stringify({ vetoes: kVetoed.length\x2C disposed: kDynDisposed.length\x2C teamResume: kTeamResume.length\x2C apiErrors: kApiErrors.length\x2C takeover: kTakeover.status }))\n    }\n\n    stopHost(boot3.child)\n    liveHost = null\n    await waitForPortFree(HOST_PORT)\n    log('boot 3 stopped (SIGTERM)')\n  } catch (e) {\n    // Controlled failure: record the error\x2C dump the live instance log\x2C\n    // tear the live host down\x2C and fall through to the summary (no\n    // uncaught-throw crash leaving orphaned hosts \u2014 the run-5 failure mode).\n    const msg = String(e?.message ?? e)\n    log(`UNEXPECTED ERROR in legs: ${msg}`)\n    if (e?.stack) log(String(e.stack).split('\\n').slice(1\x2C 6).join('\\n'))\n    if (liveHost !== null) {\n      try {\n        writeEvidence('diagnostics'\x2C 'unexpected-error-instance-tail.log'\x2C logTail(liveHost.instanceLog\x2C 60))\n      } catch { /* best effort */ }\n      stopHost(liveHost.child)\n      await waitForPortFree(HOST_PORT).catch(() => {})\n      liveHost = null\n      log('live host stopped after unexpected error (SIGTERM)')\n    }\n    die(`unexpected error: ${msg}`)\n    return finish(1)\n  } finally {\n    await mock.close()\n  }\n\n  const postStable = { p3080: await probePort(3080)\x2C p3180: await probePort(3180) }\n  writeEvidence('s0-preflight'\x2C 'post-stable-probe.json'\x2C postStable)\n  return finish(0)\n}\n\nfunction finish(code) {\n  const passed = results.filter((r) => r.ok).length\n  const failed = results.filter((r) => !r.ok)\n  writeEvidence('summary'\x2C 'checks.json'\x2C { stamp: RUN_STAMP\x2C passed\x2C failed: failed.length\x2C results\x2C lagEvents: globalThis.__rst017Lag?.events ?? [] })\n  log(`summary: ${passed} passed\x2C ${failed.length} failed`)\n  for (const f of failed) log(`  FAIL [${f.leg}] ${f.name} \u2014 ${f.detail}`)\n  log(`evidence: ${EVIDENCE_DIR}`)\n  process.exitCode = code\n}\n\nmain().catch((e) => {\n  console.error('spike crashed:'\x2C e)\n  process.exitCode = 1\n})\n
