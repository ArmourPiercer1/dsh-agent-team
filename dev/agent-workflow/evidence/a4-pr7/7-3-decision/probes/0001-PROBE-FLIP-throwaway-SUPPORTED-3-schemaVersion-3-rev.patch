+export const SUPPORTED_BLUEPRINT_DOCUMENT_VERSIONS: readonly number[] = [3]
 
 /**
  * Every Blueprint DOCUMENT VERSION this product has ever defined and shipped:
diff --git a/packages/domain/blueprint/src/types.ts b/packages/domain/blueprint/src/types.ts
index 87f1942d..e7e6902b 100644
--- a/packages/domain/blueprint/src/types.ts
+++ b/packages/domain/blueprint/src/types.ts
@@ -413,7 +413,7 @@ export interface TeamBlueprint {
    * (ADR A1-19). `3` is admitted for the PR1-PR6 bridge only (ADR A2-11); the
    * Alpha.4 contract is v3-only and the PR7 cutover narrows the accepted set.
    */
-  readonly schemaVersion: 1 | 2 | 3
+  readonly schemaVersion: 3
   /** Stable logical identity (not a path, not a display name). */
   readonly blueprintId: BlueprintId
   /** Human-readable revision. */
