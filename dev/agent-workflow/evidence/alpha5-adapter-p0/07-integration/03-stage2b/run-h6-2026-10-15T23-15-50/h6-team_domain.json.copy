      "team.a5p0.h6-main@1": "{\"blueprintId\":\"team.a5p0.h6-main\",\"contentHash\":\"sha256:26f023a27846bd9c9a4e6f602146f6fd52572c3b9fec98c9b3feac2557840b03\",\"frozenAt\":\"2026-10-15T23:15:53.747Z\",\"revision\":\"1\",\"schemaVersion\":2,\"source\":\"---\\nschemaVersion: 3\\nblueprintId: team.a5p0.h6-main\\nrevision: \\\"1\\\"\\nleader:\\n  templateId: leader\\n  persona: \\\"You are the leader of the a5p0 h6 main team. A5P0MK_L1_2026-10-15T23-15-50 drives your chain; separate system notices arrive for approvals.\\\"\\n  capabilities:\\n    teamTools:\\n      kind: allow\\n      items:\\n        - team_list_members\\n        - team_list_templates\\n        - team_inspect_config\\n        - team_create_member\\n        - team_delegate\\n        - team_collect\\n        - team_list_pending_control\\n        - team_resolve_control\\n    builtinToolDeny:\\n      - glob\\n      - grep\\n    skills:\\n      kind: allow\\n      items: []\\n    mcp:\\n      kind: allow\\n      items: []\\n    permissions:\\n      default: ask\\n      allow:\\n        - tool: read\\n          resource:\\n            kind: subtree\\n            path: team\\n      ask:\\n        - tool: bash\\n          resource:\\n            kind: any\\n      deny: []\\nteamEnvelope:\\n  allow:\\n    - assign-task\\n    - create-member\\n    - send-message\\n    - report-progress\\n    - request-control\\n    - resolve-control\\n  deny: []\\nmembers:\\n  - templateId: strict\\n    displayName: \\\"strict worker\\\"\\n    persona: \\\"You are a worker of the a5p0 h6 main team (strict lane). Follow the delegated script exactly, one tool call at a time.\\\"\\n    capabilities:\\n      teamTools:\\n        kind: deny\\n      builtinToolDeny:\\n        - glob\\n        - grep\\n      skills:\\n        kind: allow\\n        items: []\\n      mcp:\\n        kind: allow\\n        items: []\\n      permissions:\\n        default: ask\\n        allow:\\n          - tool: read\\n            resource:\\n            