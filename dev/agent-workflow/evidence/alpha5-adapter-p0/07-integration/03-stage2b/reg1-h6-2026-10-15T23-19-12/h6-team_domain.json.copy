      "team.a5p0.h6-main@1": "{\"blueprintId\":\"team.a5p0.h6-main\",\"contentHash\":\"sha256:fe0f3713bf03d5049e3336246d5a5ac5143098b067fc7dfd423cbade93b3df82\",\"frozenAt\":\"2026-10-15T23:19:15.715Z\",\"revision\":\"1\",\"schemaVersion\":2,\"source\":\"---\\nschemaVersion: 3\\nblueprintId: team.a5p0.h6-main\\nrevision: \\\"1\\\"\\nleader:\\n  templateId: leader\\n  persona: \\\"You are the leader of the a5p0 h6 main team. A5P0MK_L1_2026-10-15T23-19-12 drives your chain; separate system notices arrive for approvals.\\\"\\n  capabilities:\\n    teamTools:\\n      kind: allow\\n      items:\\n        - team_list_members\\n        - team_list_templates\\n        - team_inspect_config\\n        - team_create_member\\n        - team_delegate\\n        - team_collect\\n        - team_list_pending_control\\n        - team_resolve_control\\n    builtinToolDeny:\\n      - glob\\n      - grep\\n    skills:\\n      kind: allow\\n      items: []\\n    mcp:\\n      kind: allow\\n      items: []\\n    permissions:\\n      default: ask\\n      allow:\\n        - tool: read\\n          resource:\\n            kind: subtree\\n            path: team\\n      ask:\\n        - tool: bash\\n          resource:\\n            kind: any\\n      deny: []\\nteamEnvelope:\\n  allow:\\n    - assign-task\\n    - create-member\\n    - send-message\\n    - report-progress\\n    - request-control\\n    - resolve-control\\n  deny: []\\nmembers:\\n  - templateId: strict\\n    displayName: \\\"strict worker\\\"\\n    persona: \\\"You are a worker of the a5p0 h6 main team (strict lane). Follow the delegated script exactly, one tool call at a time.\\\"\\n    capabilities:\\n      teamTools:\\n        kind: deny\\n      builtinToolDeny:\\n        - glob\\n        - grep\\n      skills:\\n        kind: allow\\n        items: []\\n      mcp:\\n        kind: allow\\n        items: []\\n      permissions:\\n        default: ask\\n        allow:\\n          - tool: read\\n            resource:\\n              kind: any\\n        ask:\\n          - tool: bash\\n            resource:\\n              kind: any\\n          - tool: edit\\n            resource:\\n              kind: any\\n        deny:\\n          - tool: write\\n            resource:\\n              kind: any\\n  - templateId: ctl\\n    displayName: \\\"legacy control worker\\\"\\n    persona: \\\"You are a worker of the a5p0 h6 main team (legacy control lane). Follow the delegated script exactly, one tool call at a time.\\\"\\n  - templateId: nobash\\n    displayName: \\\"no-bash worker\\\"\\n    persona: \\\"You are a worker of the a5p0 h6 main team (no-bash lane). Follow the delegated script exactly, one tool call at a time.\\\"\\n    capabilities:\\n      teamTools:\\n        kind: deny\\n      builtinToolDeny:\\n        - glob\\n        - grep\\n        - bash\\n      skills:\\n        kind: allow\\n        items: []\\n      mcp:\\n        kind: allow\\n        items: []\\n      permissions:\\n        default: deny\\n        allow:\\n          - tool: read\\n            resource:\\n              kind: any\\n        ask: []\\n        deny: []\\nmemberEnvelopes:\\n  - templateId: strict\\n    envelope:\\n      allow:\\n        - send-message\\n        - report-progress\\n        - request-control\\n      deny: []\\n  - templateId: nobash\\n    envelope:\\n      allow:\\n        - send-message\\n        - report-progress\\n        - request-control\\n      deny: []\\npermissionMutationEnvelope:\\n  rules: []\\nteamHardEnvelope:\\n  rules: []\\npolicyStates: []\\nmetadata: {}\\n---\\n\"}"
